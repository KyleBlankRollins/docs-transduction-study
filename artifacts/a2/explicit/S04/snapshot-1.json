"- link \"Skip to content\":\n  - /url: \"#_top\"\n- banner:\n  - link \"Astro\":\n    - /url: https://astro.build/\n    - img\n  - link \"Docs\":\n    - /url: /en/getting-started/\n    - img\n  - button \"Search\":\n    - img\n    - text: Search\n  - link \"GitHub\":\n    - /url: https://github.com/withastro/astro\n  - link \"Discord\":\n    - /url: https://astro.build/chat\n  - text: Select theme\n  - combobox \"Select theme\":\n    - option \"Dark\"\n    - option \"Light\"\n    - option \"Auto\" [selected]\n  - text: Select language\n  - combobox \"Select language\":\n    - option \"English\" [selected]\n    - option \"Deutsch\"\n    - option \"Portugu\u00eas do Brasil\"\n    - option \"Espa\u00f1ol\"\n    - option \"\u7b80\u4f53\u4e2d\u6587\"\n    - option \"\u6b63\u9ad4\u4e2d\u6587\"\n    - option \"Fran\u00e7ais\"\n    - option \"\u0939\u093f\u0928\u094d\u0926\u0940\"\n    - option \"\u0627\u0644\u0639\u0631\u0628\u064a\u0629\"\n    - option \"\u65e5\u672c\u8a9e\"\n    - option \"\ud55c\uad6d\uc5b4\"\n    - option \"Polski\"\n    - option \"\u0420\u0443\u0441\u0441\u043a\u0438\u0439\"\n    - option \"Italiano\"\n- navigation \"Main\":\n  - tablist:\n    - tab \"Tutorial\"\n    - tab \"Guide\"\n    - tab \"Reference\"\n    - tab \"Ecosystem\" [selected]\n  - tabpanel \"Ecosystem\":\n    - list:\n      - listitem:\n        - group: UI frameworks\n      - listitem:\n        - group: Adapters\n      - listitem:\n        - group: Other official integrations\n      - listitem:\n        - group: Deployment guides\n      - listitem:\n        - group: Content management systems\n      - listitem:\n        - group:\n          - text: Backend services\n          - list:\n            - listitem:\n              - link \"Backend services overview\":\n                - /url: /en/guides/backend/\n            - listitem:\n              - link \"Appwrite\":\n                - /url: /en/guides/backend/appwrite/\n            - listitem:\n              - link \"Firebase\":\n                - /url: /en/guides/backend/firebase/\n            - listitem:\n              - link \"Neon\":\n                - /url: /en/guides/backend/neon/\n            - listitem:\n              - link \"Prisma Postgres\":\n                - /url: /en/guides/backend/prisma-postgres/\n            - listitem:\n              - link \"Scalekit\":\n                - /url: /en/guides/backend/scalekit/\n            - listitem:\n              - link \"Sentry\":\n                - /url: /en/guides/backend/sentry/\n            - listitem:\n              - link \"Supabase\":\n                - /url: /en/guides/backend/supabase/\n            - listitem:\n              - link \"Turso\":\n                - /url: /en/guides/backend/turso/\n            - listitem:\n              - link \"Xata\":\n                - /url: /en/guides/backend/xata/\n      - listitem:\n        - group: Image and video hosting\n      - listitem:\n        - link \"E-commerce\":\n          - /url: /en/guides/ecommerce/\n      - listitem:\n        - link \"Authentication\":\n          - /url: /en/guides/authentication/\n      - listitem:\n        - link \"Testing\":\n          - /url: /en/guides/testing/\n  - heading \"Sponsored by\" [level=2]\n  - link \"Netlify\":\n    - /url: https://www.netlify.com/?utm_campaign=Astro-2024&utm_source=astro-referral\n  - link \"Webflow\":\n    - /url: https://webflow.com/feature/cloud?utm_source=Astro&utm_medium=tech-partner&utm_campaign=fy26-astro&utm_content=fy26-docs\n  - link \"Cloudflare\":\n    - /url: https://www.cloudflare.com/?utm_source=astro&utm_medium=astro&utm_campaign=astro\n  - link \"Mux\":\n    - /url: https://www.mux.com/?utm_campaign=21819274-Astro&utm_source=astro\n  - link \"Image Kit\":\n    - /url: https://imagekit.io/?utm_source=astro&utm_medium=astro&utm_campaign=astro\n  - link \"Mintlify\":\n    - /url: https://www.mintlify.com/?utm_source=astro&utm_medium=astro&utm_campaign=astro\n- complementary:\n  - navigation \"On this page\":\n    - heading \"On this page\" [level=2]\n    - list:\n      - listitem:\n        - link \"Overview\":\n          - /url: \"#_top\"\n      - listitem:\n        - link \"Initializing Firebase in Astro\":\n          - /url: \"#initializing-firebase-in-astro\"\n        - list:\n          - listitem:\n            - link \"Prerequisites\":\n              - /url: \"#prerequisites\"\n          - listitem:\n            - link \"Adding Firebase credentials\":\n              - /url: \"#adding-firebase-credentials\"\n          - listitem:\n            - link \"Installing dependencies\":\n              - /url: \"#installing-dependencies\"\n      - listitem:\n        - link \"Adding authentication with Firebase\":\n          - /url: \"#adding-authentication-with-firebase\"\n        - list:\n          - listitem:\n            - link \"Prerequisites\":\n              - /url: \"#prerequisites-1\"\n          - listitem:\n            - link \"Creating auth server endpoints\":\n              - /url: \"#creating-auth-server-endpoints\"\n          - listitem:\n            - link \"Creating pages\":\n              - /url: \"#creating-pages\"\n          - listitem:\n            - link \"Adding OAuth providers\":\n              - /url: \"#adding-oauth-providers\"\n      - listitem:\n        - link \"Connecting to Firestore database\":\n          - /url: \"#connecting-to-firestore-database\"\n        - list:\n          - listitem:\n            - link \"Prerequisites\":\n              - /url: \"#prerequisites-2\"\n          - listitem:\n            - link \"Creating the server endpoints\":\n              - /url: \"#creating-the-server-endpoints\"\n          - listitem:\n            - link \"Creating pages\":\n              - /url: \"#creating-pages-1\"\n      - listitem:\n        - link \"Community Resources\":\n          - /url: \"#community-resources\"\n  - complementary \"Learn Astro with James Q Quick\":\n    - img \"Scrimba\"\n    - heading \"Learn Astro with James Q Quick\" [level=2]:\n      - strong: Learn Astro\n      - text: with James Q Quick\n    - paragraph: Build your first site with 35 interactive Scrimba lessons\n    - link \"Get 20% off\":\n      - /url: https://scrimba.com/intro-to-astro-c00ar0fi5u?via=astro\n- main:\n  - heading \"Firebase & Astro\" [level=1]\n  - paragraph:\n    - link \"Firebase\":\n      - /url: https://firebase.google.com/\n    - text: is an app development platform that provides a NoSQL database, authentication, realtime subscriptions, functions, and storage.\n  - paragraph:\n    - text: See our separate guide for\n    - link \"deploying to Firebase hosting\":\n      - /url: /en/guides/deploy/firebase/\n    - text: .\n  - heading \"Initializing Firebase in Astro\" [level=2]\n  - link \"Section titled \u201cInitializing Firebase in Astro\u201d\":\n    - /url: \"#initializing-firebase-in-astro\"\n  - heading \"Prerequisites\" [level=3]\n  - link \"Section titled \u201cPrerequisites\u201d\":\n    - /url: \"#prerequisites\"\n  - list:\n    - listitem:\n      - text: A\n      - link \"Firebase project with a web app configured\":\n        - /url: https://firebase.google.com/docs/web/setup\n      - text: .\n    - listitem:\n      - text: An Astro project with\n      - 'link \"output: ''server'' for on-demand rendering\"':\n        - /url: /en/guides/on-demand-rendering/\n        - code: \"output: 'server'\"\n        - text: for on-demand rendering\n      - text: enabled.\n    - listitem:\n      - text: \"Firebase credentials: You will need two sets of credentials to connect Astro to Firebase:\"\n      - list:\n        - listitem:\n          - text: \"Web app credentials: These credentials will be used by the client side of your app. You can find them in the Firebase console under\"\n          - emphasis: Project settings > General\n          - text: . Scroll down to the\n          - strong: Your apps\n          - text: section and click on the\n          - strong: Web app\n          - text: icon.\n        - listitem:\n          - text: \"Project credentials: These credentials will be used by the server side of your app. You can generate them in the Firebase console under\"\n          - emphasis: Project settings > Service accounts > Firebase Admin SDK > Generate new private key\n          - text: .\n  - heading \"Adding Firebase credentials\" [level=3]\n  - link \"Section titled \u201cAdding Firebase credentials\u201d\":\n    - /url: \"#adding-firebase-credentials\"\n  - paragraph:\n    - text: To add your Firebase credentials to Astro, create an\n    - code: .env\n    - text: \"file in the root of your project with the following variables:\"\n  - figure \".env\":\n    - text: .env\n    - code: FIREBASE_PRIVATE_KEY_ID=YOUR_PRIVATE_KEY_ID FIREBASE_PRIVATE_KEY=YOUR_PRIVATE_KEY FIREBASE_PROJECT_ID=YOUR_PROJECT_ID FIREBASE_CLIENT_EMAIL=YOUR_CLIENT_EMAIL FIREBASE_CLIENT_ID=YOUR_CLIENT_ID FIREBASE_AUTH_URI=YOUR_AUTH_URI FIREBASE_TOKEN_URI=YOUR_TOKEN_URI FIREBASE_AUTH_CERT_URL=YOUR_AUTH_CERT_URL FIREBASE_CLIENT_CERT_URL=YOUR_CLIENT_CERT_URL\n    - button \"Copy to clipboard\"\n  - paragraph: Now, these environment variables are available for use in your project.\n  - paragraph:\n    - text: If you would like to have IntelliSense for your Firebase environment variables, edit or create the file\n    - code: env.d.ts\n    - text: in your\n    - code: src/\n    - text: \"directory and configure your types:\"\n  - figure \"src/env.d.ts\":\n    - text: src/env.d.ts\n    - code: \"interface ImportMetaEnv { readonly FIREBASE_PRIVATE_KEY_ID: string; readonly FIREBASE_PRIVATE_KEY: string; readonly FIREBASE_PROJECT_ID: string; readonly FIREBASE_CLIENT_EMAIL: string; readonly FIREBASE_CLIENT_ID: string; readonly FIREBASE_AUTH_URI: string; readonly FIREBASE_TOKEN_URI: string; readonly FIREBASE_AUTH_CERT_URL: string readonly FIREBASE_CLIENT_CERT_URL: string; } interface ImportMeta { readonly env: ImportMetaEnv; }\"\n    - button \"Copy to clipboard\"\n  - complementary \"Tip\":\n    - paragraph:\n      - text: Read more about\n      - link \"environment variables\":\n        - /url: /en/guides/environment-variables/\n      - text: and\n      - code: .env\n      - text: files in Astro.\n  - paragraph: \"Your project should now include these new files:\"\n  - list:\n    - listitem:\n      - group:\n        - text: Directory src/\n        - list:\n          - listitem:\n            - strong: env.d.ts\n    - listitem:\n      - strong: .env\n    - listitem: astro.config.mjs\n    - listitem: package.json\n  - heading \"Installing dependencies\" [level=3]\n  - link \"Section titled \u201cInstalling dependencies\u201d\":\n    - /url: \"#installing-dependencies\"\n  - paragraph: \"To connect Astro with Firebase, install the following packages using the single command below for your preferred package manager:\"\n  - list:\n    - listitem:\n      - code: firebase\n      - text: \"- the Firebase SDK for the client side\"\n    - listitem:\n      - code: firebase-admin\n      - text: \"- the Firebase Admin SDK for the server side\"\n  - tablist:\n    - tab \"npm\" [selected]\n    - tab \"pnpm\"\n    - tab \"Yarn\"\n  - tabpanel \"npm\":\n    - figure \"Terminal window\":\n      - text: Terminal window\n      - code: npm install firebase firebase-admin\n      - button \"Copy to clipboard\"\n  - paragraph:\n    - text: Next, create a folder named\n    - code: firebase\n    - text: in the\n    - code: src/\n    - text: \"directory and add two new files to this folder:\"\n    - code: client.ts\n    - text: and\n    - code: server.ts\n    - text: .\n  - paragraph:\n    - text: In\n    - code: client.ts\n    - text: \", add the following code to initialize Firebase in the client using your web app credentials and the\"\n    - code: firebase\n    - text: \"package:\"\n  - figure \"src/firebase/client.ts\":\n    - text: src/firebase/client.ts\n    - code: \"import { initializeApp } from \\\"firebase/app\\\"; const firebaseConfig = { apiKey: \\\"my-public-api-key\\\", authDomain: \\\"my-auth-domain\\\", projectId: \\\"my-project-id\\\", storageBucket: \\\"my-storage-bucket\\\", messagingSenderId: \\\"my-sender-id\\\", appId: \\\"my-app-id\\\", }; export const app = initializeApp(firebaseConfig);\"\n    - button \"Copy to clipboard\"\n  - complementary \"Note\":\n    - paragraph:\n      - text: Remember to replace the\n      - code: firebaseConfig\n      - text: object with your own web app credentials.\n  - paragraph:\n    - text: In\n    - code: server.ts\n    - text: \", add the following code to initialize Firebase in the server using your project credentials and the\"\n    - code: firebase-admin\n    - text: \"package:\"\n  - figure \"src/firebase/server.ts\":\n    - text: src/firebase/server.ts\n    - region:\n      - code: \"import type { ServiceAccount } from \\\"firebase-admin\\\"; import { initializeApp, cert, getApps } from \\\"firebase-admin/app\\\"; const activeApps = getApps(); const serviceAccount = { type: \\\"service_account\\\", project_id: import.meta.env.FIREBASE_PROJECT_ID, private_key_id: import.meta.env.FIREBASE_PRIVATE_KEY_ID, private_key: import.meta.env.FIREBASE_PRIVATE_KEY, client_email: import.meta.env.FIREBASE_CLIENT_EMAIL, client_id: import.meta.env.FIREBASE_CLIENT_ID, auth_uri: import.meta.env.FIREBASE_AUTH_URI, token_uri: import.meta.env.FIREBASE_TOKEN_URI, auth_provider_x509_cert_url: import.meta.env.FIREBASE_AUTH_CERT_URL, client_x509_cert_url: import.meta.env.FIREBASE_CLIENT_CERT_URL, }; const initApp = () => { if (import.meta.env.PROD) { console.info('PROD env detected. Using default service account.') // Use default config in firebase functions. Should be already injected in the server by Firebase. return initializeApp() } console.info('Loading service account from env.') return initializeApp({ credential: cert(serviceAccount as ServiceAccount) }) } export const app = activeApps.length === 0 ? initApp() : activeApps[0];\"\n    - button \"Copy to clipboard\"\n  - complementary \"Note\":\n    - paragraph:\n      - text: Remember to replace the\n      - code: serviceAccount\n      - text: object with your own project credentials.\n  - paragraph: \"Finally, your project should now include these new files:\"\n  - list:\n    - listitem:\n      - group:\n        - text: Directory src\n        - list:\n          - listitem: env.d.ts\n          - listitem:\n            - group:\n              - text: Directory firebase\n              - list:\n                - listitem:\n                  - strong: client.ts\n                - listitem:\n                  - strong: server.ts\n    - listitem: .env\n    - listitem: astro.config.mjs\n    - listitem: package.json\n  - heading \"Adding authentication with Firebase\" [level=2]\n  - link \"Section titled \u201cAdding authentication with Firebase\u201d\":\n    - /url: \"#adding-authentication-with-firebase\"\n  - heading \"Prerequisites\" [level=3]\n  - link \"Section titled \u201cPrerequisites\u201d\":\n    - /url: \"#prerequisites-1\"\n  - list:\n    - listitem:\n      - text: An Astro project\n      - link \"initialized with Firebase\":\n        - /url: \"#initializing-firebase-in-astro\"\n      - text: .\n    - listitem:\n      - text: A Firebase project with email/password authentication enabled in the Firebase console under\n      - emphasis: Authentication > Sign-in\n      - text: method.\n  - heading \"Creating auth server endpoints\" [level=3]\n  - link \"Section titled \u201cCreating auth server endpoints\u201d\":\n    - /url: \"#creating-auth-server-endpoints\"\n  - paragraph:\n    - text: Firebase authentication in Astro requires the following three\n    - link \"Astro server endpoints\":\n      - /url: /en/guides/endpoints/\n    - text: \":\"\n  - list:\n    - listitem:\n      - code: GET /api/auth/signin\n      - text: \"- to sign in a user\"\n    - listitem:\n      - code: GET /api/auth/signout\n      - text: \"- to sign out a user\"\n    - listitem:\n      - code: POST /api/auth/register\n      - text: \"- to register a user\"\n  - paragraph:\n    - text: Create three endpoints related to authentication in a new directory\n    - code: src/pages/api/auth/\n    - text: \":\"\n    - code: signin.ts\n    - text: \",\"\n    - code: signout.ts\n    - text: and\n    - code: register.ts\n    - text: .\n  - paragraph:\n    - code: signin.ts\n    - text: \"contains the code to sign in a user using Firebase:\"\n  - figure \"src/pages/api/auth/signin.ts\":\n    - text: src/pages/api/auth/signin.ts\n    - region:\n      - code: \"import type { APIRoute } from \\\"astro\\\"; import { app } from \\\"../../../firebase/server\\\"; import { getAuth } from \\\"firebase-admin/auth\\\"; export const GET: APIRoute = async ({ request, cookies, redirect }) => { const auth = getAuth(app); /* Get token from request headers */ const idToken = request.headers.get(\\\"Authorization\\\")?.split(\\\"Bearer \\\")[1]; if (!idToken) { return new Response( \\\"No token found\\\", { status: 401 } ); } /* Verify id token */ try { await auth.verifyIdToken(idToken); } catch (error) { return new Response( \\\"Invalid token\\\", { status: 401 } ); } /* Create and set session cookie */ const fiveDays = 60 * 60 * 24 * 5 * 1000; const sessionCookie = await auth.createSessionCookie(idToken, { expiresIn: fiveDays, }); cookies.set(\\\"__session\\\", sessionCookie, { path: \\\"/\\\", }); return redirect(\\\"/dashboard\\\"); };\"\n    - button \"Copy to clipboard\"\n  - complementary \"Caution\":\n    - paragraph:\n      - text: Firebase only allows the use of\n      - link \"one cookie, and it must be named __session\":\n        - /url: https://firebase.google.com/docs/hosting/manage-cache#using_cookies\n        - text: one cookie, and it must be named\n        - code: __session\n      - text: . Any other cookies the client sends will not be visible to your application.\n  - complementary \"Note\":\n    - paragraph: This is a basic implementation of the signin endpoint. You can add more logic to this endpoint to suit your needs.\n  - paragraph:\n    - code: signout.ts\n    - text: \"contains the code to log out a user by deleting the session cookie:\"\n  - figure \"src/pages/api/auth/signout.ts\":\n    - text: src/pages/api/auth/signout.ts\n    - code: \"import type { APIRoute } from \\\"astro\\\"; export const GET: APIRoute = async ({ redirect, cookies }) => { cookies.delete(\\\"__session\\\", { path: \\\"/\\\", }); return redirect(\\\"/signin\\\"); };\"\n    - button \"Copy to clipboard\"\n  - complementary \"Note\":\n    - paragraph: This is a basic implementation of the signout endpoint. You can add more logic to this endpoint to suit your needs.\n  - paragraph:\n    - code: register.ts\n    - text: \"contains the code to register a user using Firebase:\"\n  - figure \"src/pages/api/auth/register.ts\":\n    - text: src/pages/api/auth/register.ts\n    - code: \"import type { APIRoute } from \\\"astro\\\"; import { getAuth } from \\\"firebase-admin/auth\\\"; import { app } from \\\"../../../firebase/server\\\"; export const POST: APIRoute = async ({ request, redirect }) => { const auth = getAuth(app); /* Get form data */ const formData = await request.formData(); const email = formData.get(\\\"email\\\")?.toString(); const password = formData.get(\\\"password\\\")?.toString(); const name = formData.get(\\\"name\\\")?.toString(); if (!email || !password || !name) { return new Response( \\\"Missing form data\\\", { status: 400 } ); } /* Create user */ try { await auth.createUser({ email, password, displayName: name, }); } catch (error: any) { return new Response( \\\"Something went wrong\\\", { status: 400 } ); } return redirect(\\\"/signin\\\"); };\"\n    - button \"Copy to clipboard\"\n  - complementary \"Note\":\n    - paragraph: This is a basic implementation of the register endpoint. You can add more logic to this endpoint to suit your needs.\n  - paragraph: \"After creating server endpoints for authentication, your project directory should now include these new files:\"\n  - list:\n    - listitem:\n      - group:\n        - text: Directory src\n        - list:\n          - listitem: env.d.ts\n          - listitem:\n            - group:\n              - text: Directory firebase\n              - list:\n                - listitem: client.ts\n                - listitem: server.ts\n          - listitem:\n            - group:\n              - text: Directory pages\n              - list:\n                - listitem:\n                  - group:\n                    - text: Directory api\n                    - list:\n                      - listitem:\n                        - group:\n                          - text: Directory auth\n                          - list:\n                            - listitem:\n                              - strong: signin.ts\n                            - listitem:\n                              - strong: signout.ts\n                            - listitem:\n                              - strong: register.ts\n    - listitem: .env\n    - listitem: astro.config.mjs\n    - listitem: package.json\n  - heading \"Creating pages\" [level=3]\n  - link \"Section titled \u201cCreating pages\u201d\":\n    - /url: \"#creating-pages\"\n  - paragraph: \"Create the pages that will use the Firebase endpoints:\"\n  - list:\n    - listitem:\n      - code: src/pages/register\n      - text: \"- will contain a form to register a user\"\n    - listitem:\n      - code: src/pages/signin\n      - text: \"- will contain a form to sign in a user\"\n    - listitem:\n      - code: src/pages/dashboard\n      - text: \"- will contain a dashboard that can only be accessed by authenticated users\"\n  - paragraph:\n    - text: The example\n    - code: src/pages/register.astro\n    - text: below includes a form that will send a\n    - code: POST\n    - text: request to the\n    - code: /api/auth/register\n    - text: endpoint. This endpoint will create a new user using the data from the form and then will redirect the user to the\n    - code: /signin\n    - text: page.\n  - figure \"src/pages/register.astro\":\n    - text: src/pages/register.astro\n    - code: \"--- import Layout from \\\"../layouts/Layout.astro\\\"; --- <Layout title=\\\"Register\\\"> <h1>Register</h1> <p>Already have an account? <a href=\\\"/signin\\\">Sign in</a></p> <form action=\\\"/api/auth/register\\\" method=\\\"post\\\"> <label for=\\\"name\\\">Name</label> <input type=\\\"text\\\" name=\\\"name\\\" id=\\\"name\\\" /> <label for=\\\"email\\\" for=\\\"email\\\">Email</label> <input type=\\\"email\\\" name=\\\"email\\\" id=\\\"email\\\" /> <label for=\\\"password\\\">Password</label> <input type=\\\"password\\\" name=\\\"password\\\" id=\\\"password\\\" /> <button type=\\\"submit\\\">Login</button> </form> </Layout>\"\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - code: src/pages/signin.astro\n    - text: uses the Firebase server app to verify the user\u2019s session cookie. If the user is authenticated, the page will redirect the user to the\n    - code: /dashboard\n    - text: page.\n  - paragraph:\n    - text: The example page below contains a form that will send a\n    - code: POST\n    - text: request to the\n    - code: /api/auth/signin\n    - text: endpoint with the ID token generated by the Firebase client app.\n  - paragraph:\n    - text: The endpoint will verify the ID token and create a new session cookie for the user. Then, the endpoint will redirect the user to the\n    - code: /dashboard\n    - text: page.\n  - figure \"src/pages/signin.astro\":\n    - text: src/pages/signin.astro\n    - code: \"--- import { app } from \\\"../firebase/server\\\"; import { getAuth } from \\\"firebase-admin/auth\\\"; import Layout from \\\"../layouts/Layout.astro\\\"; /* Check if the user is authenticated */ const auth = getAuth(app); if (Astro.cookies.has(\\\"__session\\\")) { const sessionCookie = Astro.cookies.get(\\\"__session\\\")!.value; const decodedCookie = await auth.verifySessionCookie(sessionCookie); if (decodedCookie) { return Astro.redirect(\\\"/dashboard\\\"); } } --- <Layout title=\\\"Sign in\\\"> <h1>Sign in</h1> <p>New here? <a href=\\\"/register\\\">Create an account</a></p> <form action=\\\"/api/auth/signin\\\" method=\\\"post\\\"> <label for=\\\"email\\\" for=\\\"email\\\">Email</label> <input type=\\\"email\\\" name=\\\"email\\\" id=\\\"email\\\" /> <label for=\\\"password\\\">Password</label> <input type=\\\"password\\\" name=\\\"password\\\" id=\\\"password\\\" /> <button type=\\\"submit\\\">Login</button> </form> </Layout> <script> import { getAuth, inMemoryPersistence, signInWithEmailAndPassword, } from \\\"firebase/auth\\\"; import { app } from \\\"../firebase/client\\\"; const auth = getAuth(app); // This will prevent the browser from storing session data auth.setPersistence(inMemoryPersistence); const form = document.querySelector(\\\"form\\\") as HTMLFormElement; form.addEventListener(\\\"submit\\\", async (e) => { e.preventDefault(); const formData = new FormData(form); const email = formData.get(\\\"email\\\")?.toString(); const password = formData.get(\\\"password\\\")?.toString(); if (!email || !password) { return; } const userCredential = await signInWithEmailAndPassword( auth, email, password ); const idToken = await userCredential.user.getIdToken(); const response = await fetch(\\\"/api/auth/signin\\\", { method: \\\"GET\\\", headers: { Authorization: `Bearer ${idToken}`, }, }); if (response.redirected) { window.location.assign(response.url); } }); </script>\"\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - code: src/pages/dashboard.astro\n    - text: will verify the user\u2019s session cookie using the Firebase server app. If the user is not authenticated, the page will redirect the user to the\n    - code: /signin\n    - text: page.\n  - paragraph:\n    - text: The example page below displays the user\u2019s name and a button to sign out. Clicking the button will send a\n    - code: GET\n    - text: request to the\n    - code: /api/auth/signout\n    - text: endpoint.\n  - paragraph:\n    - text: The endpoint will delete the user\u2019s session cookie and redirect the user to the\n    - code: /signin\n    - text: page.\n  - figure \"src/pages/dashboard.astro\":\n    - text: src/pages/dashboard.astro\n    - code: \"--- import { app } from \\\"../firebase/server\\\"; import { getAuth } from \\\"firebase-admin/auth\\\"; import Layout from \\\"../layouts/Layout.astro\\\"; const auth = getAuth(app); /* Check current session */ if (!Astro.cookies.has(\\\"__session\\\")) { return Astro.redirect(\\\"/signin\\\"); } const sessionCookie = Astro.cookies.get(\\\"__session\\\")!.value; const decodedCookie = await auth.verifySessionCookie(sessionCookie); const user = await auth.getUser(decodedCookie.uid); if (!user) { return Astro.redirect(\\\"/signin\\\"); } --- <Layout title=\\\"dashboard\\\"> <h1>Welcome {user.displayName}</h1> <p>We are happy to see you here</p> <form action=\\\"/api/auth/signout\\\"> <button type=\\\"submit\\\">Sign out</button> </form> </Layout>\"\n    - button \"Copy to clipboard\"\n  - heading \"Adding OAuth providers\" [level=3]\n  - link \"Section titled \u201cAdding OAuth providers\u201d\":\n    - /url: \"#adding-oauth-providers\"\n  - paragraph: To add OAuth providers to your app, you need to enable them in the Firebase console.\n  - paragraph:\n    - text: In the Firebase console, go to the\n    - strong: Authentication\n    - text: section and click on the\n    - strong: Sign-in method\n    - text: tab. Then, click on the\n    - strong: Add a new provider\n    - text: button and enable the providers you want to use.\n  - paragraph:\n    - text: The example below uses the\n    - strong: Google\n    - text: provider.\n  - paragraph:\n    - text: Edit the\n    - code: signin.astro\n    - text: \"page to add:\"\n  - list:\n    - listitem: a button to sign in with Google underneath the existing form\n    - listitem:\n      - text: an event listener on the button to handle the sign in process in the existing\n      - code: <script>\n      - text: .\n  - figure \"src/pages/signin.astro\":\n    - text: src/pages/signin.astro\n    - region:\n      - code: \"--- import { app } from \\\"../firebase/server\\\"; import { getAuth } from \\\"firebase-admin/auth\\\"; import Layout from \\\"../layouts/Layout.astro\\\"; /* Check if the user is authenticated */ const auth = getAuth(app); if (Astro.cookies.has(\\\"__session\\\")) { const sessionCookie = Astro.cookies.get(\\\"__session\\\")!.value; const decodedCookie = await auth.verifySessionCookie(sessionCookie); if (decodedCookie) { return Astro.redirect(\\\"/dashboard\\\"); } } --- <Layout title=\\\"Sign in\\\"> <h1>Sign in</h1> <p>New here? <a href=\\\"/register\\\">Create an account</a></p> <form action=\\\"/api/auth/signin\\\" method=\\\"post\\\"> <label for=\\\"email\\\" for=\\\"email\\\">Email</label> <input type=\\\"email\\\" name=\\\"email\\\" id=\\\"email\\\" /> <label for=\\\"password\\\">Password</label> <input type=\\\"password\\\" name=\\\"password\\\" id=\\\"password\\\" /> <button type=\\\"submit\\\">Login</button> </form> + <button id=\\\"google\\\">Sign in with Google</button> </Layout> <script> import { getAuth, inMemoryPersistence, signInWithEmailAndPassword, + GoogleAuthProvider, + signInWithPopup, } from \\\"firebase/auth\\\"; import { app } from \\\"../firebase/client\\\"; const auth = getAuth(app); auth.setPersistence(inMemoryPersistence); const form = document.querySelector(\\\"form\\\") as HTMLFormElement; form.addEventListener(\\\"submit\\\", async (e) => { e.preventDefault(); const formData = new FormData(form); const email = formData.get(\\\"email\\\")?.toString(); const password = formData.get(\\\"password\\\")?.toString(); if (!email || !password) { return; } const userCredential = await signInWithEmailAndPassword( auth, email, password ); const idToken = await userCredential.user.getIdToken(); const response = await fetch(\\\"/api/auth/signin\\\", { headers: { Authorization: `Bearer ${idToken}`, }, }); if (response.redirected) { window.location.assign(response.url); } }); + const googleSignin = document.querySelector(\\\"#google\\\") as HTMLButtonElement; + googleSignin.addEventListener(\\\"click\\\", async () => { + const provider = new GoogleAuthProvider(); + const userCredential = await signInWithPopup(auth, provider); + const idToken = await userCredential.user.getIdToken(); + const res = await fetch(\\\"/api/auth/signin\\\", { + headers: { + Authorization: `Bearer ${idToken}`, + }, + }); + + if (res.redirected) { + window.location.assign(res.url); + } + }); </script>\"\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - text: When clicked, the Google sign in button will open a popup window to sign in with Google. Once the user signs in, it will send a\n    - code: POST\n    - text: request to the\n    - code: /api/auth/signin\n    - text: endpoint with the ID token generated by OAuth provider.\n  - paragraph:\n    - text: The endpoint will verify the ID token and create a new session cookie for the user. Then, the endpoint will redirect the user to the\n    - code: /dashboard\n    - text: page.\n  - heading \"Connecting to Firestore database\" [level=2]\n  - link \"Section titled \u201cConnecting to Firestore database\u201d\":\n    - /url: \"#connecting-to-firestore-database\"\n  - heading \"Prerequisites\" [level=3]\n  - link \"Section titled \u201cPrerequisites\u201d\":\n    - /url: \"#prerequisites-2\"\n  - list:\n    - listitem:\n      - paragraph:\n        - text: An Astro project initialized with Firebase as described in the\n        - link \"Initializing Firebase in Astro\":\n          - /url: \"#initializing-firebase-in-astro\"\n        - text: section.\n    - listitem:\n      - paragraph:\n        - text: A Firebase project with a Firestore database. You can follow the\n        - link \"Firebase documentation to create a new project and set up a Firestore database\":\n          - /url: https://firebase.google.com/docs/firestore/quickstart\n        - text: .\n  - paragraph:\n    - text: In this recipe, the Firestore collection will be called\n    - strong: friends\n    - text: \"and will contain documents with the following fields:\"\n  - list:\n    - listitem:\n      - code: id\n      - text: \": autogenerated by Firestore\"\n    - listitem:\n      - code: name\n      - text: \": a string field\"\n    - listitem:\n      - code: age\n      - text: \": a number field\"\n    - listitem:\n      - code: isBestFriend\n      - text: \": a boolean field\"\n  - heading \"Creating the server endpoints\" [level=3]\n  - link \"Section titled \u201cCreating the server endpoints\u201d\":\n    - /url: \"#creating-the-server-endpoints\"\n  - paragraph:\n    - text: Create two new files in a new directory\n    - code: src/pages/api/friends/\n    - text: \":\"\n    - code: index.ts\n    - text: and\n    - code: \"[id].ts\"\n    - text: \". These will create two server endpoints to interact with the Firestore database in the following ways:\"\n  - list:\n    - listitem:\n      - code: POST /api/friends\n      - text: \": to create a new document in the friends collection.\"\n    - listitem:\n      - code: POST /api/friends/:id\n      - text: \": to update a document in the friends collection.\"\n    - listitem:\n      - code: DELETE /api/friends/:id\n      - text: \": to delete a document in the friends collection.\"\n  - paragraph:\n    - code: index.ts\n    - text: \"will contain the code to create a new document in the friends collection:\"\n  - figure \"src/pages/api/friends/index.ts\":\n    - text: src/pages/api/friends/index.ts\n    - code: \"import type { APIRoute } from \\\"astro\\\"; import { app } from \\\"../../../firebase/server\\\"; import { getFirestore } from \\\"firebase-admin/firestore\\\"; export const POST: APIRoute = async ({ request, redirect }) => { const formData = await request.formData(); const name = formData.get(\\\"name\\\")?.toString(); const age = formData.get(\\\"age\\\")?.toString(); const isBestFriend = formData.get(\\\"isBestFriend\\\") === \\\"on\\\"; if (!name || !age) { return new Response(\\\"Missing required fields\\\", { status: 400, }); } try { const db = getFirestore(app); const friendsRef = db.collection(\\\"friends\\\"); await friendsRef.add({ name, age: parseInt(age), isBestFriend, }); } catch (error) { return new Response(\\\"Something went wrong\\\", { status: 500, }); } return redirect(\\\"/dashboard\\\"); };\"\n    - button \"Copy to clipboard\"\n  - complementary \"Note\":\n    - paragraph:\n      - text: This is a basic implementation of the\n      - code: friends\n      - text: endpoint. You can add more logic to this endpoint to suit your needs.\n  - paragraph:\n    - code: \"[id].ts\"\n    - text: \"will contain the code to update and delete a document in the friends collection:\"\n  - figure \"src/pages/api/friends/[id].ts\":\n    - text: src/pages/api/friends/[id].ts\n    - code: \"import type { APIRoute } from \\\"astro\\\"; import { app } from \\\"../../../firebase/server\\\"; import { getFirestore } from \\\"firebase-admin/firestore\\\"; const db = getFirestore(app); const friendsRef = db.collection(\\\"friends\\\"); export const POST: APIRoute = async ({ params, redirect, request }) => { const formData = await request.formData(); const name = formData.get(\\\"name\\\")?.toString(); const age = formData.get(\\\"age\\\")?.toString(); const isBestFriend = formData.get(\\\"isBestFriend\\\") === \\\"on\\\"; if (!name || !age) { return new Response(\\\"Missing required fields\\\", { status: 400, }); } if (!params.id) { return new Response(\\\"Cannot find friend\\\", { status: 404, }); } try { await friendsRef.doc(params.id).update({ name, age: parseInt(age), isBestFriend, }); } catch (error) { return new Response(\\\"Something went wrong\\\", { status: 500, }); } return redirect(\\\"/dashboard\\\"); }; export const DELETE: APIRoute = async ({ params, redirect }) => { if (!params.id) { return new Response(\\\"Cannot find friend\\\", { status: 404, }); } try { await friendsRef.doc(params.id).delete(); } catch (error) { return new Response(\\\"Something went wrong\\\", { status: 500, }); } return redirect(\\\"/dashboard\\\"); };\"\n    - button \"Copy to clipboard\"\n  - complementary \"Note\":\n    - paragraph:\n      - text: This is a basic implementation of the\n      - code: friends/:id\n      - text: endpoint. You can add more logic to this endpoint to suit your needs.\n  - paragraph: \"After creating server endpoints for Firestore, your project directory should now include these new files:\"\n  - list:\n    - listitem:\n      - group:\n        - text: Directory src\n        - list:\n          - listitem: env.d.ts\n          - listitem:\n            - group:\n              - text: Directory firebase\n              - list:\n                - listitem: client.ts\n                - listitem: server.ts\n          - listitem:\n            - group:\n              - text: Directory pages\n              - list:\n                - listitem:\n                  - group:\n                    - text: Directory api\n                    - list:\n                      - listitem:\n                        - group:\n                          - text: Directory friends\n                          - list:\n                            - listitem:\n                              - strong: index.ts\n                            - listitem:\n                              - strong: \"[id].ts\"\n    - listitem: .env\n    - listitem: astro.config.mjs\n    - listitem: package.json\n  - heading \"Creating pages\" [level=3]\n  - link \"Section titled \u201cCreating pages\u201d\":\n    - /url: \"#creating-pages-1\"\n  - paragraph: \"Create the pages that will use the Firestore endpoints:\"\n  - list:\n    - listitem:\n      - code: src/pages/add.astro\n      - text: \"- will contain a form to add a new friend.\"\n    - listitem:\n      - code: src/pages/edit/[id].astro\n      - text: \"- will contain a form to edit a friend and a button to delete a friend.\"\n    - listitem:\n      - code: src/pages/friend/[id].astro\n      - text: \"- will contain the details of a friend.\"\n    - listitem:\n      - code: src/pages/dashboard.astro\n      - text: \"- will display a list of friends.\"\n  - heading \"Add a new record\" [level=4]\n  - link \"Section titled \u201cAdd a new record\u201d\":\n    - /url: \"#add-a-new-record\"\n  - paragraph:\n    - text: The example\n    - code: src/pages/add.astro\n    - text: below includes a form that will send a\n    - code: POST\n    - text: request to the\n    - code: /api/friends\n    - text: endpoint. This endpoint will create a new friend using the data from the form and then will redirect the user to the\n    - code: /dashboard\n    - text: page.\n  - figure \"src/pages/add.astro\":\n    - text: src/pages/add.astro\n    - code: \"--- import Layout from \\\"../layouts/Layout.astro\\\"; --- <Layout title=\\\"Add a new friend\\\"> <h1>Add a new friend</h1> <form method=\\\"post\\\" action=\\\"/api/friends\\\"> <label for=\\\"name\\\">Name</label> <input type=\\\"text\\\" id=\\\"name\\\" name=\\\"name\\\" /> <label for=\\\"age\\\">Age</label> <input type=\\\"number\\\" id=\\\"age\\\" name=\\\"age\\\" /> <label for=\\\"isBestFriend\\\">Is best friend?</label> <input type=\\\"checkbox\\\" id=\\\"isBestFriend\\\" name=\\\"isBestFriend\\\" /> <button type=\\\"submit\\\">Add friend</button> </form> </Layout>\"\n    - button \"Copy to clipboard\"\n  - heading \"Edit or Delete a record\" [level=4]\n  - link \"Section titled \u201cEdit or Delete a record\u201d\":\n    - /url: \"#edit-or-delete-a-record\"\n  - paragraph:\n    - code: src/pages/edit/[id].astro\n    - text: will contain a form to edit a friend data and a button to delete a friend. On submit, this page will send a\n    - code: POST\n    - text: request to the\n    - code: /api/friends/:id\n    - text: endpoint to update a friend data.\n  - paragraph:\n    - text: If the user clicks the delete button, this page will send a\n    - code: DELETE\n    - text: request to the\n    - code: /api/friends/:id\n    - text: endpoint to delete a friend.\n  - figure \"src/pages/edit/[id].astro\":\n    - text: src/pages/edit/[id].astro\n    - region:\n      - code: \"--- import Layout from \\\"../../layouts/Layout.astro\\\"; import { app } from \\\"../../firebase/server\\\"; import { getFirestore } from \\\"firebase-admin/firestore\\\"; interface Friend { name: string; age: number; isBestFriend: boolean; } const { id } = Astro.params; if (!id) { return Astro.redirect(\\\"/404\\\"); } const db = getFirestore(app); const friendsRef = db.collection(\\\"friends\\\"); const friendSnapshot = await friendsRef.doc(id).get(); if (!friendSnapshot.exists) { return Astro.redirect(\\\"/404\\\"); } const friend = friendSnapshot.data() as Friend; --- <Layout title=\\\"Edit {friend.name}\\\"> <h1>Edit {friend.name}</h1> <p>Here you can edit or delete your friend's data.</p> <form method=\\\"post\\\" action={`/api/friends/${id}`}> <label for=\\\"name\\\">Name</label> <input type=\\\"text\\\" id=\\\"name\\\" name=\\\"name\\\" value={friend.name} /> <label for=\\\"age\\\">Age</label> <input type=\\\"number\\\" id=\\\"age\\\" name=\\\"age\\\" value={friend.age} /> <label for=\\\"isBestFriend\\\">Is best friend?</label> <input type=\\\"checkbox\\\" id=\\\"isBestFriend\\\" name=\\\"isBestFriend\\\" checked={friend.isBestFriend} /> <button type=\\\"submit\\\">Edit friend</button> </form> <button type=\\\"button\\\" id=\\\"delete-document\\\">Delete</button> </Layout> <script> const deleteButton = document.getElementById( \\\"delete-document\\\" ) as HTMLButtonElement; const url = document.querySelector(\\\"form\\\")?.getAttribute(\\\"action\\\") as string; deleteButton.addEventListener(\\\"click\\\", async () => { const response = await fetch(url, { method: \\\"DELETE\\\", }); if (response.redirected) { window.location.assign(response.url); } }); </script>\"\n    - button \"Copy to clipboard\"\n  - heading \"Display an individual record\" [level=4]\n  - link \"Section titled \u201cDisplay an individual record\u201d\":\n    - /url: \"#display-an-individual-record\"\n  - paragraph:\n    - code: src/pages/friend/[id].astro\n    - text: will display the details of a friend.\n  - figure \"src/pages/friend/[id].astro\":\n    - text: src/pages/friend/[id].astro\n    - code: \"--- import Layout from \\\"../../layouts/Layout.astro\\\"; import { app } from \\\"../../firebase/server\\\"; import { getFirestore } from \\\"firebase-admin/firestore\\\"; interface Friend { name: string; age: number; isBestFriend: boolean; } const { id } = Astro.params; if (!id) { return Astro.redirect(\\\"/404\\\"); } const db = getFirestore(app); const friendsRef = db.collection(\\\"friends\\\"); const friendSnapshot = await friendsRef.doc(id).get(); if (!friendSnapshot.exists) { return Astro.redirect(\\\"/404\\\"); } const friend = friendSnapshot.data() as Friend; --- <Layout title={friend.name}> <h1>{friend.name}</h1> <p>Age: {friend.age}</p> <p>Is best friend: {friend.isBestFriend ? \\\"Yes\\\" : \\\"No\\\"}</p> </Layout>\"\n    - button \"Copy to clipboard\"\n  - heading \"Display a list of records with an edit button\" [level=4]\n  - link \"Section titled \u201cDisplay a list of records with an edit button\u201d\":\n    - /url: \"#display-a-list-of-records-with-an-edit-button\"\n  - paragraph:\n    - text: Finally,\n    - code: src/pages/dashboard.astro\n    - text: will display a list of friends. Each friend will have a link to their details page and an edit button that will redirect the user to the edit page.\n  - figure \"src/pages/dashboard.astro\":\n    - text: src/pages/dashboard.astro\n    - code: \"--- import { app } from \\\"../firebase/server\\\"; import { getFirestore } from \\\"firebase-admin/firestore\\\"; import Layout from \\\"../layouts/Layout.astro\\\"; interface Friend { id: string; name: string; age: number; isBestFriend: boolean; } const db = getFirestore(app); const friendsRef = db.collection(\\\"friends\\\"); const friendsSnapshot = await friendsRef.get(); const friends = friendsSnapshot.docs.map((doc) => ({ id: doc.id, ...doc.data(), })) as Friend[]; --- <Layout title=\\\"My friends\\\"> <h1>Friends</h1> <ul> { friends.map((friend) => ( <li> <a href={`/friend/${friend.id}`}>{friend.name}</a> <span>({friend.age})</span> <strong>{friend.isBestFriend ? \\\"Bestie\\\" : \\\"Friend\\\"}</strong> <a href={`/edit/${friend.id}`}>Edit</a> </li> )) } </ul> </Layout>\"\n    - button \"Copy to clipboard\"\n  - paragraph: \"After creating all the pages, you should have the following file structure:\"\n  - list:\n    - listitem:\n      - group:\n        - text: Directory src\n        - list:\n          - listitem: env.d.ts\n          - listitem:\n            - group:\n              - text: Directory firebase\n              - list:\n                - listitem: client.ts\n                - listitem: server.ts\n          - listitem:\n            - group:\n              - text: Directory pages\n              - list:\n                - listitem: dashboard.astro\n                - listitem: add.astro\n                - listitem:\n                  - group:\n                    - text: Directory edit\n                    - list:\n                      - listitem: \"[id].astro\"\n                - listitem:\n                  - group:\n                    - text: Directory friend\n                    - list:\n                      - listitem: \"[id].astro\"\n                - listitem:\n                  - group:\n                    - text: Directory api\n                    - list:\n                      - listitem:\n                        - group:\n                          - text: Directory friends\n                          - list:\n                            - listitem: index.ts\n                            - listitem: \"[id].ts\"\n    - listitem: .env\n    - listitem: astro.config.mjs\n    - listitem: package.json\n  - heading \"Community Resources\" [level=2]\n  - link \"Section titled \u201cCommunity Resources\u201d\":\n    - /url: \"#community-resources\"\n  - list:\n    - listitem:\n      - link \"Astro and Firebase SSR app example\":\n        - /url: https://github.com/kevinzunigacuellar/astro-firebase\n    - listitem:\n      - 'link \"Using Firebase Realtime Database in Astro with Vue: A Step-by-Step Guide\"':\n        - /url: https://www.launchfa.st/blog/vue-astro-firebase-realtime-database\n  - heading \"More backend service guides\" [level=2]\n  - list:\n    - listitem:\n      - heading \"Appwrite\" [level=3]:\n        - link \"Appwrite\":\n          - /url: /en/guides/backend/appwrite/\n    - listitem:\n      - heading \"Firebase\" [level=3]:\n        - link \"Firebase\":\n          - /url: /en/guides/backend/firebase/\n    - listitem:\n      - heading \"Neon\" [level=3]:\n        - link \"Neon\":\n          - /url: /en/guides/backend/neon/\n    - listitem:\n      - heading \"Prisma Postgres\" [level=3]:\n        - link \"Prisma Postgres\":\n          - /url: /en/guides/backend/prisma-postgres/\n    - listitem:\n      - heading \"Scalekit\" [level=3]:\n        - link \"Scalekit\":\n          - /url: /en/guides/backend/scalekit/\n    - listitem:\n      - heading \"Sentry\" [level=3]:\n        - link \"Sentry\":\n          - /url: /en/guides/backend/sentry/\n    - listitem:\n      - heading \"Supabase\" [level=3]:\n        - link \"Supabase\":\n          - /url: /en/guides/backend/supabase/\n    - listitem:\n      - heading \"Turso\" [level=3]:\n        - link \"Turso\":\n          - /url: /en/guides/backend/turso/\n    - listitem:\n      - heading \"Xata\" [level=3]:\n        - link \"Xata\":\n          - /url: /en/guides/backend/xata/\n  - link \"Edit page\":\n    - /url: https://github.com/withastro/docs/edit/main/src/content/docs/en/guides/backend/firebase.mdx\n  - link \"Translate this page\":\n    - /url: https://contribute.docs.astro.build/guides/i18n/\n  - link \"Previous Appwrite\":\n    - /url: /en/guides/backend/appwrite/\n  - link \"Next Neon\":\n    - /url: /en/guides/backend/neon/\n  - link \"Contribute\":\n    - /url: /en/contribute/\n  - link \"Community\":\n    - /url: https://astro.build/chat\n    - img\n    - text: Community\n  - link \"Sponsor\":\n    - /url: https://opencollective.com/astrodotbuild"