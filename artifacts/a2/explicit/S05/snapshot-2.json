des/view-transitions/\n      - listitem:\n        - group:\n          - text: Build your UI\n          - list:\n            - listitem:\n              - link \"Components\":\n                - /url: /en/basics/astro-components/\n            - listitem:\n              - link \"Layouts\":\n                - /url: /en/basics/layouts/\n            - listitem:\n              - link \"Styles and CSS\":\n                - /url: /en/guides/styling/\n            - listitem:\n              - link \"Fonts\":\n                - /url: /en/guides/fonts/\n            - listitem:\n              - link \"Syntax Highlighting\":\n                - /url: /en/guides/syntax-highlighting/\n            - listitem:\n              - link \"Scripts and event handling\":\n                - /url: /en/guides/client-side-scripts/\n            - listitem:\n              - link \"Front-end frameworks\":\n                - /url: /en/guides/framework-components/\n      - listitem:\n        - group:\n          - text: Add content to your site\n          - list:\n            - listitem:\n              - link \"Markdown\":\n                - /url: /en/guides/markdown-content/\n            - listitem:\n              - link \"Content collections\":\n                - /url: /en/guides/content-collections/\n            - listitem:\n              - link \"Images\":\n                - /url: /en/guides/images/\n            - listitem:\n              - link \"Data fetching\":\n                - /url: /en/guides/data-fetching/\n      - listitem:\n        - group:\n          - text: Server rendering\n          - list:\n            - listitem:\n              - link \"On-demand rendering\":\n                - /url: /en/guides/on-demand-rendering/\n            - listitem:\n              - link \"Server islands\":\n                - /url: /en/guides/server-islands/\n            - listitem:\n              - link \"Actions\":\n                - /url: /en/guides/actions/\n            - listitem:\n              - link \"Sessions\":\n                - /url: /en/guides/sessions/\n            - listitem:\n              - link \"Route caching\":\n                - /url: /en/guides/caching/\n      - listitem:\n        - group:\n          - text: Upgrade\n          - list:\n            - listitem:\n              - link \"Upgrade Astro\":\n                - /url: /en/upgrade-astro/\n            - listitem:\n              - group: Major upgrade guides\n      - listitem:\n        - link \"Troubleshooting\":\n          - /url: /en/guides/troubleshooting/\n      - listitem:\n        - group:\n          - text: How-to recipes\n          - list:\n            - listitem:\n              - link \"Recipes overview\":\n                - /url: /en/recipes/\n            - listitem:\n              - link \"Installing a Vite or Rollup plugin\":\n                - /url: /en/recipes/add-yaml-support/\n            - listitem:\n              - link \"Analyze bundle size\":\n                - /url: /en/recipes/analyze-bundle-size/\n            - listitem:\n              - link \"Build a custom image component\":\n                - /url: /en/recipes/build-custom-img-component/\n            - listitem:\n              - link \"Build HTML forms in Astro pages\":\n                - /url: /en/recipes/build-forms/\n            - listitem:\n              - link \"Build forms with API routes\":\n                - /url: /en/recipes/build-forms-api/\n            - listitem:\n              - link \"Use Bun with Astro\":\n                - /url: /en/recipes/bun/\n            - listitem:\n              - link \"Call endpoints from the server\":\n                - /url: /en/recipes/call-endpoints/\n            - listitem:\n              - link \"Verify a Captcha\":\n                - /url: /en/recipes/captcha/\n            - listitem:\n              - link \"Customize file names in the build output\":\n                - /url: /en/recipes/customizing-output-filenames/\n            - listitem:\n              - link \"Build your Astro site with Docker\":\n                - /url: /en/recipes/docker/\n            - listitem:\n              - link \"Dynamically import images\":\n                - /url: /en/recipes/dynamically-importing-images/\n            - listitem:\n              - link \"Add icons to external links\":\n                - /url: /en/recipes/external-links/\n            - listitem:\n              - link \"Add i18n features\":\n                - /url: /en/recipes/i18n/\n            - listitem:\n              - link \"Create a dev toolbar app\":\n                - /url: /en/recipes/making-toolbar-apps/\n            - listitem:\n              - link \"Add last modified time\":\n                - /url: /en/recipes/modified-time/\n            - listitem:\n              - link \"Add reading time\":\n                - /url: /en/recipes/reading-time/\n            - listitem:\n              - link \"Add an RSS feed\":\n                - /url: /en/recipes/rss/\n            - listitem:\n              - link \"Share state between Astro components\":\n                - /url: /en/recipes/sharing-state/\n            - listitem:\n              - link \"Share state between islands\":\n                - /url: /en/recipes/sharing-state-islands/\n            - listitem:\n              - link \"Using streaming to improve page performance\":\n                - /url: /en/recipes/streaming-improve-page-performance/\n            - listitem:\n              - link \"Style rendered Markdown with Tailwind Typography\":\n                - /url: /en/recipes/tailwind-rendered-markdown/\n      - listitem:\n        - group: Migrate to Astro\n      - listitem:\n        - link \"Contribute to Astro\":\n          - /url: /en/contribute/\n  - heading \"Sponsored by\" [level=2]\n  - link \"Netlify\":\n    - /url: https://www.netlify.com/?utm_campaign=Astro-2024&utm_source=astro-referral\n  - link \"Webflow\":\n    - /url: https://webflow.com/feature/cloud?utm_source=Astro&utm_medium=tech-partner&utm_campaign=fy26-astro&utm_content=fy26-docs\n  - link \"Cloudflare\":\n    - /url: https://www.cloudflare.com/?utm_source=astro&utm_medium=astro&utm_campaign=astro\n  - link \"Mux\":\n    - /url: https://www.mux.com/?utm_campaign=21819274-Astro&utm_source=astro\n  - link \"Image Kit\":\n    - /url: https://imagekit.io/?utm_source=astro&utm_medium=astro&utm_campaign=astro\n  - link \"Mintlify\":\n    - /url: https://www.mintlify.com/?utm_source=astro&utm_medium=astro&utm_campaign=astro\n- complementary:\n  - navigation \"On this page\":\n    - heading \"On this page\" [level=2]\n    - list:\n      - listitem:\n        - link \"Overview\":\n          - /url: \"#_top\"\n      - listitem:\n        - link \"Prerequisites\":\n          - /url: \"#prerequisites\"\n      - listitem:\n        - link \"Creating a Dockerfile\":\n          - /url: \"#creating-a-dockerfile\"\n        - list:\n          - listitem:\n            - link \"SSR\":\n              - /url: \"#ssr\"\n          - listitem:\n            - link \"Adding a .dockerignore\":\n              - /url: \"#adding-a-dockerignore\"\n          - listitem:\n            - link \"Static\":\n              - /url: \"#static\"\n          - listitem:\n            - link \"Multi-stage build (using SSR)\":\n              - /url: \"#multi-stage-build-using-ssr\"\n      - listitem:\n        - link \"Recipe\":\n          - /url: \"#recipe\"\n  - complementary \"Learn Astro with James Q Quick\":\n    - img \"Scrimba\"\n    - heading \"Learn Astro with James Q Quick\" [level=2]:\n      - strong: Learn Astro\n      - text: with James Q Quick\n    - paragraph: Build your first site with 35 interactive Scrimba lessons\n    - link \"Get 20% off\":\n      - /url: https://scrimba.com/intro-to-astro-c00ar0fi5u?via=astro\n- main:\n  - heading \"Build your Astro site with Docker\" [level=1]\n  - paragraph:\n    - link \"Docker\":\n      - /url: https://docker.com\n    - text: is a tool to build, deploy, and run applications using containers.\n  - paragraph:\n    - text: Docker images and containers can be deployed to many different platforms, like AWS, Azure, and\n    - link \"Google Cloud\":\n      - /url: /en/guides/deploy/google-cloud/#cloud-run-ssr-and-static\n    - text: . This recipe won\u2019t cover how to deploy your site to a specific platform but will show you how to set up Docker for your project.\n  - heading \"Prerequisites\" [level=2]\n  - link \"Section titled \u201cPrerequisites\u201d\":\n    - /url: \"#prerequisites\"\n  - list:\n    - listitem:\n      - text: Docker installed on your local machine. You can find\n      - link \"installation instructions for your operating system here\":\n        - /url: https://docs.docker.com/get-docker/\n      - text: .\n    - listitem:\n      - text: A Dockerfile in your project. You can\n      - link \"learn more about Dockerfiles here\":\n        - /url: https://docs.docker.com/engine/reference/builder/\n      - text: and use the Dockerfiles in the following section as a starting point.\n  - heading \"Creating a Dockerfile\" [level=2]\n  - link \"Section titled \u201cCreating a Dockerfile\u201d\":\n    - /url: \"#creating-a-dockerfile\"\n  - paragraph:\n    - text: Create a file called\n    - code: Dockerfile\n    - text: in your project\u2019s root directory. This file contains the instructions to build your site, which will differ depending on your needs. This guide can\u2019t show all possible options but will give you starting points for SSR and static mode.\n  - paragraph: If you\u2019re using another package manager than npm, you\u2019ll need to adjust the commands accordingly.\n  - heading \"SSR\" [level=3]\n  - link \"Section titled \u201cSSR\u201d\":\n    - /url: \"#ssr\"\n  - paragraph:\n    - text: This Dockerfile will build your site and serve it using Node.js on port\n    - code: \"4321\"\n    - text: and therefore requires the\n    - link \"Node adapter\":\n      - /url: /en/guides/integrations-guide/node/\n    - text: installed in your Astro project.\n  - figure \"Dockerfile\":\n    - text: Dockerfile\n    - code: FROM node:lts AS runtime WORKDIR /app COPY . . RUN npm install RUN npm run build ENV HOST=0.0.0.0 ENV PORT=4321 EXPOSE 4321 CMD [\"node\", \"./dist/server/entry.mjs\"]\n    - button \"Copy to clipboard\"\n  - complementary \"Keep this in mind\":\n    - paragraph:\n      - text: These are just examples of Dockerfiles. You can customize them to your needs. For example, you could use another image, like\n      - code: node:lts-alpine\n      - text: \":\"\n    - figure \"Dockerfile\":\n      - text: Dockerfile\n      - code: \"- FROM node:lts as runtime + FROM node:lts-alpine as runtime\"\n      - button \"Copy to clipboard\"\n  - heading \"Adding a .dockerignore\" [level=3]\n  - link \"Section titled \u201cAdding a .dockerignore\u201d\":\n    - /url: \"#adding-a-dockerignore\"\n  - paragraph:\n    - text: Adding a\n    - code: .dockerignore\n    - text: file to your project is best practice. This file describes which files or folders should be ignored in the Docker\n    - code: COPY\n    - text: or\n    - code: ADD\n    - text: commands, very similar to how\n    - code: .gitignore\n    - text: works. This speeds up the build process and reduces the size of the final image.\n  - figure \".dockerignore\":\n    - text: .dockerignore\n    - code: .DS_Store node_modules dist\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - text: This file should go in the same directory as the\n    - code: Dockerfile\n    - text: itself.\n    - link \"Read the .dockerignore documentation for extra info\":\n      - /url: https://docs.docker.com/engine/reference/builder/#dockerignore-file\n      - text: Read the\n      - code: .dockerignore\n      - text: documentation for extra info\n  - heading \"Static\" [level=3]\n  - link \"Section titled \u201cStatic\u201d\":\n    - /url: \"#static\"\n  - heading \"Apache (httpd)\" [level=4]\n  - link \"Section titled \u201cApache (httpd)\u201d\":\n    - /url: \"#apache-httpd\"\n  - paragraph:\n    - text: The following Dockerfile will build your site and serve it using Apache httpd on port\n    - code: \"80\"\n    - text: with the default configuration.\n  - figure \"Dockerfile\":\n    - text: Dockerfile\n    - code: FROM node:lts AS build WORKDIR /app COPY . . RUN npm i RUN npm run build FROM httpd:2.4 AS runtime COPY --from=build /app/dist /usr/local/apache2/htdocs/ EXPOSE 80\n    - button \"Copy to clipboard\"\n  - complementary \"Recommendation\":\n    - paragraph: Use this approach for simple websites that don\u2019t need any special configuration. For more complex websites, it is recommended to use a custom configuration, either in Apache or NGINX.\n  - heading \"NGINX\" [level=4]\n  - link \"Section titled \u201cNGINX\u201d\":\n    - /url: \"#nginx\"\n  - figure \"Dockerfile\":\n    - text: Dockerfile\n    - code: FROM node:lts AS build WORKDIR /app COPY package*.json ./ RUN npm install COPY . . RUN npm run build FROM nginx:alpine AS runtime COPY ./nginx/nginx.conf /etc/nginx/nginx.conf COPY --from=build /app/dist /usr/share/nginx/html EXPOSE 8080\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - text: In order to build the Dockerfile above, you\u2019ll also need to create a configuration file for NGINX. Create a folder called\n    - code: nginx\n    - text: in your project\u2019s root directory and create a file called\n    - code: nginx.conf\n    - text: inside.\n  - figure \"nginx.conf\":\n    - text: nginx.conf\n    - region:\n      - code: \"worker_processes 1; events { worker_connections 1024; } http { server { listen 8080; server_name _; root /usr/share/nginx/html; index index.html index.htm; include /etc/nginx/mime.types; gzip on; gzip_min_length 1000; gzip_proxied expired no-cache no-store private auth; gzip_types text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript; error_page 404 /404.html; location = /404.html { root /usr/share/nginx/html; internal; } location / { try_files $uri $uri/index.html =404; } } }\"\n    - button \"Copy to clipboard\"\n  - heading \"Multi-stage build (using SSR)\" [level=3]\n  - link \"Section titled \u201cMulti-stage build (using SSR)\u201d\":\n    - /url: \"#multi-stage-build-using-ssr\"\n  - paragraph:\n    - text: Here\u2019s an example of a more advanced Dockerfile that, thanks to Docker\u2019s\n    - link \"multi-stage builds\":\n      - /url: https://docs.docker.com/build/building/multi-stage/\n    - text: \", optimizes the build process for your site by not reinstalling the npm dependencies when only the source code changes. This can reduce the build time even by minutes, depending on the size of your dependencies.\"\n  - figure \"Dockerfile\":\n    - text: Dockerfile\n    - region:\n      - code: \"FROM node:lts AS base WORKDIR /app # By copying only the package.json and package-lock.json here, we ensure that the following `-deps` steps are independent of the source code. # Therefore, the `-deps` steps will be skipped if only the source code changes. COPY package.json package-lock.json ./ FROM base AS prod-deps RUN npm install --omit=dev FROM base AS build-deps RUN npm install FROM build-deps AS build COPY . . RUN npm run build FROM base AS runtime COPY --from=prod-deps /app/node_modules ./node_modules COPY --from=build /app/dist ./dist ENV HOST=0.0.0.0 ENV PORT=4321 EXPOSE 4321 CMD [\\\"node\\\", \\\"./dist/server/entry.mjs\\\"]\"\n    - button \"Copy to clipboard\"\n  - heading \"Recipe\" [level=2]\n  - link \"Section titled \u201cRecipe\u201d\":\n    - /url: \"#recipe\"\n  - list:\n    - listitem:\n      - paragraph:\n        - text: Build your container by running the following command in your project\u2019s root directory. Use any name for\n        - code: <your-astro-image-name>\n        - text: \":\"\n      - figure \"Terminal window\":\n        - text: Terminal window\n        - code: docker build -t <your-astro-image-name> .\n        - button \"Copy to clipboard\"\n      - paragraph: This will output an image, which you can run locally or deploy to a platform of your choice.\n    - listitem:\n      - paragraph: To run your image as a local container, use the following command.\n      - paragraph:\n        - text: Replace\n        - code: <local-port>\n        - text: with an open port on your machine. Replace\n        - code: <container-port>\n        - text: with the port exposed by your Docker container (\n        - code: \"4321\"\n        - text: \",\"\n        - code: \"80\"\n        - text: \", or\"\n        - code: \"8080\"\n        - text: in the above examples.)\n      - figure \"Terminal window\":\n        - text: Terminal window\n        - region:\n          - code: docker run -p <local-port>:<container-port> <your-astro-image-name>\n        - button \"Copy to clipboard\"\n      - paragraph:\n        - text: You should be able to access your site at\n        - code: http://localhost:<local-port>\n        - text: .\n    - listitem:\n      - paragraph:\n        - text: Now that your website is successfully built and packaged in a container, you can deploy it to a cloud provider. See the\n        - link \"Google Cloud\":\n          - /url: /en/guides/deploy/google-cloud/#cloud-run-ssr-and-static\n        - text: deployment guide for one example, and the\n        - link \"Deploy your app\":\n          - /url: https://docs.docker.com/language/nodejs/deploy/\n        - text: page in the Docker docs.\n  - link \"Edit page\":\n    - /url: https://github.com/withastro/docs/edit/main/src/content/docs/en/recipes/docker.mdx\n  - link \"Translate this page\":\n    - /url: https://contribute.docs.astro.build/guides/i18n/\n  - link \"Previous Customize file names in the build output\":\n    - /url: /en/recipes/customizing-output-filenames/\n  - link \"Next Dynamically import images\":\n    - /url: /en/recipes/dynamically-importing-images/\n  - link \"Contribute\":\n    - /url: /en/contribute/\n  - link \"Community\":\n    - /url: https://astro.build/chat\n    - img\n    - text: Community\n  - link \"Sponsor\":\n    - /url: https://opencollective.com/astrodotbuild"