des/view-transitions/\n      - listitem:\n        - group:\n          - text: Build your UI\n          - list:\n            - listitem:\n              - link \"Components\":\n                - /url: /en/basics/astro-components/\n            - listitem:\n              - link \"Layouts\":\n                - /url: /en/basics/layouts/\n            - listitem:\n              - link \"Styles and CSS\":\n                - /url: /en/guides/styling/\n            - listitem:\n              - link \"Fonts\":\n                - /url: /en/guides/fonts/\n            - listitem:\n              - link \"Syntax Highlighting\":\n                - /url: /en/guides/syntax-highlighting/\n            - listitem:\n              - link \"Scripts and event handling\":\n                - /url: /en/guides/client-side-scripts/\n            - listitem:\n              - link \"Front-end frameworks\":\n                - /url: /en/guides/framework-components/\n      - listitem:\n        - group:\n          - text: Add content to your site\n          - list:\n            - listitem:\n              - link \"Markdown\":\n                - /url: /en/guides/markdown-content/\n            - listitem:\n              - link \"Content collections\":\n                - /url: /en/guides/content-collections/\n            - listitem:\n              - link \"Images\":\n                - /url: /en/guides/images/\n            - listitem:\n              - link \"Data fetching\":\n                - /url: /en/guides/data-fetching/\n      - listitem:\n        - group:\n          - text: Server rendering\n          - list:\n            - listitem:\n              - link \"On-demand rendering\":\n                - /url: /en/guides/on-demand-rendering/\n            - listitem:\n              - link \"Server islands\":\n                - /url: /en/guides/server-islands/\n            - listitem:\n              - link \"Actions\":\n                - /url: /en/guides/actions/\n            - listitem:\n              - link \"Sessions\":\n                - /url: /en/guides/sessions/\n            - listitem:\n              - link \"Route caching\":\n                - /url: /en/guides/caching/\n      - listitem:\n        - group:\n          - text: Upgrade\n          - list:\n            - listitem:\n              - link \"Upgrade Astro\":\n                - /url: /en/upgrade-astro/\n            - listitem:\n              - group: Major upgrade guides\n      - listitem:\n        - link \"Troubleshooting\":\n          - /url: /en/guides/troubleshooting/\n      - listitem:\n        - group: How-to recipes\n      - listitem:\n        - group:\n          - text: Migrate to Astro\n          - list:\n            - listitem:\n              - link \"Site migration overview\":\n                - /url: /en/guides/migrate-to-astro/\n            - listitem:\n              - link \"Create React App\":\n                - /url: /en/guides/migrate-to-astro/from-create-react-app/\n            - listitem:\n              - link \"Docusaurus\":\n                - /url: /en/guides/migrate-to-astro/from-docusaurus/\n            - listitem:\n              - link \"Eleventy\":\n                - /url: /en/guides/migrate-to-astro/from-eleventy/\n            - listitem:\n              - link \"Gatsby\":\n                - /url: /en/guides/migrate-to-astro/from-gatsby/\n            - listitem:\n              - link \"GitBook\":\n                - /url: /en/guides/migrate-to-astro/from-gitbook/\n            - listitem:\n              - link \"Gridsome\":\n                - /url: /en/guides/migrate-to-astro/from-gridsome/\n            - listitem:\n              - link \"Hugo\":\n                - /url: /en/guides/migrate-to-astro/from-hugo/\n            - listitem:\n              - link \"Jekyll\":\n                - /url: /en/guides/migrate-to-astro/from-jekyll/\n            - listitem:\n              - link \"Next.js\":\n                - /url: /en/guides/migrate-to-astro/from-nextjs/\n            - listitem:\n              - link \"NuxtJS\":\n                - /url: /en/guides/migrate-to-astro/from-nuxtjs/\n            - listitem:\n              - link \"Pelican\":\n                - /url: /en/guides/migrate-to-astro/from-pelican/\n            - listitem:\n              - link \"SvelteKit\":\n                - /url: /en/guides/migrate-to-astro/from-sveltekit/\n            - listitem:\n              - link \"VuePress\":\n                - /url: /en/guides/migrate-to-astro/from-vuepress/\n            - listitem:\n              - link \"WordPress\":\n                - /url: /en/guides/migrate-to-astro/from-wordpress/\n      - listitem:\n        - link \"Contribute to Astro\":\n          - /url: /en/contribute/\n  - heading \"Sponsored by\" [level=2]\n  - link \"Netlify\":\n    - /url: https://www.netlify.com/?utm_campaign=Astro-2024&utm_source=astro-referral\n  - link \"Webflow\":\n    - /url: https://webflow.com/feature/cloud?utm_source=Astro&utm_medium=tech-partner&utm_campaign=fy26-astro&utm_content=fy26-docs\n  - link \"Cloudflare\":\n    - /url: https://www.cloudflare.com/?utm_source=astro&utm_medium=astro&utm_campaign=astro\n  - link \"Mux\":\n    - /url: https://www.mux.com/?utm_campaign=21819274-Astro&utm_source=astro\n  - link \"Image Kit\":\n    - /url: https://imagekit.io/?utm_source=astro&utm_medium=astro&utm_campaign=astro\n  - link \"Mintlify\":\n    - /url: https://www.mintlify.com/?utm_source=astro&utm_medium=astro&utm_campaign=astro\n- complementary:\n  - navigation \"On this page\":\n    - heading \"On this page\" [level=2]\n    - list:\n      - listitem:\n        - link \"Overview\":\n          - /url: \"#_top\"\n      - listitem:\n        - link \"Key Similarities between Next.js and Astro\":\n          - /url: \"#key-similarities-between-nextjs-and-astro\"\n      - listitem:\n        - link \"Key Differences between Next.js and Astro\":\n          - /url: \"#key-differences-between-nextjs-and-astro\"\n      - listitem:\n        - link \"Convert your Next.js Project\":\n          - /url: \"#convert-your-nextjs-project\"\n        - list:\n          - listitem:\n            - link \"Create a new Astro project\":\n              - /url: \"#create-a-new-astro-project\"\n          - listitem:\n            - link \"Install integrations (optional)\":\n              - /url: \"#install-integrations-optional\"\n          - listitem:\n            - link \"Put your source code in src\":\n              - /url: \"#put-your-source-code-in-src\"\n          - listitem:\n            - link \"The Astro config file\":\n              - /url: \"#the-astro-config-file\"\n          - listitem:\n            - 'link \"Tips: Convert JSX files to .astro files\"':\n              - /url: \"#tips-convert-jsx-files-to-astro-files\"\n          - listitem:\n            - link \"Migrating Layout Files\":\n              - /url: \"#migrating-layout-files\"\n          - listitem:\n            - link \"Migrating Pages and Posts\":\n              - /url: \"#migrating-pages-and-posts\"\n          - listitem:\n            - link \"Migrating Tests\":\n              - /url: \"#migrating-tests\"\n      - listitem:\n        - 'link \"Reference: Convert Next.js Syntax to Astro\"':\n          - /url: \"#reference-convert-nextjs-syntax-to-astro\"\n        - list:\n          - listitem:\n            - link \"Next Links to Astro\":\n              - /url: \"#next-links-to-astro\"\n          - listitem:\n            - link \"Next Imports to Astro\":\n              - /url: \"#next-imports-to-astro\"\n          - listitem:\n            - link \"Next Children Props to Astro\":\n              - /url: \"#next-children-props-to-astro\"\n          - listitem:\n            - link \"Next Data Fetching to Astro\":\n              - /url: \"#next-data-fetching-to-astro\"\n          - listitem:\n            - link \"Next Styling to Astro\":\n              - /url: \"#next-styling-to-astro\"\n          - listitem:\n            - link \"Next Image Plugin to Astro\":\n              - /url: \"#next-image-plugin-to-astro\"\n      - listitem:\n        - 'link \"Guided example: Next data fetching to Astro\"':\n          - /url: \"#guided-example-next-data-fetching-to-astro\"\n      - listitem:\n        - link \"Community Resources\":\n          - /url: \"#community-resources\"\n  - complementary \"Learn Astro with James Q Quick\":\n    - img \"Scrimba\"\n    - heading \"Learn Astro with James Q Quick\" [level=2]:\n      - strong: Learn Astro\n      - text: with James Q Quick\n    - paragraph: Build your first site with 35 interactive Scrimba lessons\n    - link \"Get 20% off\":\n      - /url: https://scrimba.com/intro-to-astro-c00ar0fi5u?via=astro\n- main:\n  - heading \"Migrating from Next.js\" [level=1]\n  - paragraph:\n    - text: Here are some key concepts and migration strategies to help you get started. Use the rest of our docs and our\n    - link \"Discord community\":\n      - /url: https://astro.build/chat\n    - text: to keep going!\n  - heading \"Key Similarities between Next.js and Astro\" [level=2]\n  - link \"Section titled \u201cKey Similarities between Next.js and Astro\u201d\":\n    - /url: \"#key-similarities-between-nextjs-and-astro\"\n  - paragraph: \"Next.js and Astro share some similarities that will help you migrate your project:\"\n  - list:\n    - listitem:\n      - text: The\n      - link \"syntax of .astro files is similar to JSX\":\n        - /url: /en/reference/astro-syntax/#differences-between-astro-and-jsx\n        - text: syntax of\n        - code: .astro\n        - text: files is similar to JSX\n      - text: . Writing Astro should feel familiar.\n    - listitem:\n      - text: Astro projects can also be SSG or\n      - link \"SSR with page-level prerendering\":\n        - /url: /en/guides/on-demand-rendering/\n      - text: .\n    - listitem:\n      - text: Astro uses file-based routing, and\n      - link \"allows specially named pages to create dynamic routes\":\n        - /url: /en/guides/routing/#dynamic-routes\n      - text: .\n    - listitem:\n      - text: Astro is\n      - link \"component-based\":\n        - /url: /en/basics/astro-components/\n      - text: \", and your markup structure will be similar before and after your migration.\"\n    - listitem:\n      - text: Astro has\n      - link \"official integrations for React, Preact, and Solid\":\n        - /url: /en/guides/integrations-guide/react/\n      - text: so you can use your existing JSX components. Note that in Astro, these files\n      - strong: must\n      - text: have a\n      - code: .jsx\n      - text: or\n      - code: .tsx\n      - text: extension.\n    - listitem:\n      - text: Astro has support for\n      - link \"installing NPM packages\":\n        - /url: /en/guides/imports/#npm-packages\n      - text: \", including React libraries. Many of your existing dependencies will work in Astro.\"\n  - heading \"Key Differences between Next.js and Astro\" [level=2]\n  - link \"Section titled \u201cKey Differences between Next.js and Astro\u201d\":\n    - /url: \"#key-differences-between-nextjs-and-astro\"\n  - paragraph: \"When you rebuild your Next.js site in Astro, you will notice some important differences:\"\n  - list:\n    - listitem:\n      - paragraph:\n        - text: Next.js is a React single-page app, and uses\n        - code: index.js\n        - text: as your project\u2019s root. Astro is a multi-page site, and\n        - code: index.astro\n        - text: is your home page.\n    - listitem:\n      - paragraph:\n        - link \".astro components\":\n          - /url: /en/basics/astro-components/\n          - code: .astro\n          - text: components\n        - text: are not written as exported functions that return page templating. Instead, you\u2019ll split your code into a \u201ccode fence\u201d for your JavaScript and a body exclusively for the HTML you generate.\n    - listitem:\n      - paragraph:\n        - link \"content-driven\":\n          - /url: /en/concepts/why-astro/#content-driven\n        - text: \": Astro was designed to showcase your content and to allow you to opt-in to interactivity only as needed. An existing Next.js app might be built for high client-side interactivity and may require advanced Astro techniques to include items that are more challenging to replicate using\"\n        - code: .astro\n        - text: components, such as dashboards.\n  - heading \"Convert your Next.js Project\" [level=2]\n  - link \"Section titled \u201cConvert your Next.js Project\u201d\":\n    - /url: \"#convert-your-nextjs-project\"\n  - paragraph: Each project migration will look different, but there are some common actions you will perform when converting from Next.js to Astro.\n  - heading \"Create a new Astro project\" [level=3]\n  - link \"Section titled \u201cCreate a new Astro project\u201d\":\n    - /url: \"#create-a-new-astro-project\"\n  - paragraph:\n    - text: Use the\n    - code: create astro\n    - text: command for your package manager to launch Astro\u2019s CLI wizard or choose a community theme from the\n    - link \"Astro Theme Showcase\":\n      - /url: https://astro.build/themes\n    - text: .\n  - paragraph:\n    - text: You can pass a\n    - code: \"--template\"\n    - text: argument to the\n    - code: create astro\n    - text: command to start a new Astro project with one of our official starters (e.g.\n    - code: docs\n    - text: \",\"\n    - code: blog\n    - text: \",\"\n    - code: portfolio\n    - text: ). Or, you can\n    - link \"start a new project from any existing Astro repository on GitHub\":\n      - /url: /en/install-and-setup/#install-from-the-cli-wizard\n    - text: .\n  - tablist:\n    - tab \"npm\" [selected]\n    - tab \"pnpm\"\n    - tab \"Yarn\"\n  - tabpanel \"npm\":\n    - figure \"Terminal window\":\n      - text: Terminal window\n      - code: \"# launch the Astro CLI Wizard npm create astro@latest # create a new project with an official example npm create astro@latest -- --template <example-name>\"\n      - button \"Copy to clipboard\"\n  - paragraph:\n    - text: Then, copy your existing Next project files over to your new Astro project in a separate folder outside of\n    - code: src\n    - text: .\n  - complementary \"Tip\":\n    - paragraph:\n      - text: Visit\n      - link \"https://astro.new\":\n        - /url: https://astro.new\n      - text: for the full list of official starter templates, and links for opening a new project in StackBlitz or CodeSandbox.\n  - heading \"Install integrations (optional)\" [level=3]\n  - link \"Section titled \u201cInstall integrations (optional)\u201d\":\n    - /url: \"#install-integrations-optional\"\n  - paragraph:\n    - text: You may find it useful to install some of\n    - link \"Astro\u2019s optional integrations\":\n      - /url: /en/guides/integrations/\n    - text: \"to use while converting your Next project to Astro:\"\n  - list:\n    - listitem:\n      - paragraph:\n        - strong: \"@astrojs/react\"\n        - text: \": to reuse some existing React UI components in your new Astro site, or keep writing with React components.\"\n    - listitem:\n      - paragraph:\n        - strong: \"@astrojs/mdx\"\n        - text: \": to bring existing MDX files from your Next project, or to use MDX in your new Astro site.\"\n  - heading \"Put your source code in src\" [level=3]:\n    - text: Put your source code in\n    - code: src\n  - link \"Section titled \u201cPut your source code in src\u201d\":\n    - /url: \"#put-your-source-code-in-src\"\n  - paragraph:\n    - text: Following\n    - link \"Astro\u2019s project structure\":\n      - /url: /en/basics/project-structure/\n    - text: \":\"\n  - list:\n    - listitem:\n      - paragraph:\n        - strong: Keep\n        - text: Next\u2019s\n        - code: public/\n        - text: folder untouched.\n      - paragraph:\n        - text: Astro uses the\n        - code: public/\n        - text: directory for static assets, just like Next. There is no change needed to this folder, nor its contents.\n    - listitem:\n      - paragraph:\n        - strong: Copy or Move\n        - text: Next\u2019s other files and folders (e.g.\n        - code: pages\n        - text: \",\"\n        - code: styles\n        - text: etc.) into Astro\u2019s\n        - code: src/\n        - text: folder as you rebuild your site, following\n        - link \"Astro\u2019s project structure\":\n          - /url: /en/basics/project-structure/\n        - text: .\n      - paragraph:\n        - text: Like Next, Astro\u2019s\n        - code: src/pages/\n        - text: folder is a special folder used for file-based routing. All other folders are optional, and you can organize the contents of your\n        - code: src/\n        - text: folder any way you like. Other common folders in Astro projects include\n        - code: src/layouts/\n        - text: \",\"\n        - code: src/components\n        - text: \",\"\n        - code: src/styles\n        - text: \",\"\n        - code: src/scripts\n        - text: .\n  - heading \"The Astro config file\" [level=3]\n  - link \"Section titled \u201cThe Astro config file\u201d\":\n    - /url: \"#the-astro-config-file\"\n  - paragraph:\n    - text: Astro has a configuration file at the root of your project called\n    - link \"astro.config.mjs\":\n      - /url: /en/guides/configuring-astro/\n      - code: astro.config.mjs\n    - text: . This is used only for configuring your Astro project and any installed integrations, including\n    - link \"SSR adapters\":\n      - /url: /en/guides/deploy/\n    - text: .\n  - 'heading \"Tips: Convert JSX files to .astro files\" [level=3]':\n    - text: \"Tips: Convert JSX files to\"\n    - code: .astro\n    - text: files\n  - 'link \"Section titled \u201cTips: Convert JSX files to .astro files\u201d\"':\n    - /url: \"#tips-convert-jsx-files-to-astro-files\"\n  - paragraph:\n    - text: Here are some tips for converting a Next\n    - code: .js\n    - text: component into a\n    - code: .astro\n    - text: \"component:\"\n  - list:\n    - listitem:\n      - paragraph: Use the returned JSX of the existing Next.js component function as the basis for your HTML template.\n    - listitem:\n      - paragraph:\n        - text: Change any\n        - link \"Next or JSX syntax to Astro\":\n          - /url: \"#reference-convert-nextjs-syntax-to-astro\"\n        - text: or to HTML web standards. This includes\n        - code: <Link>\n        - text: \",\"\n        - code: <Script>\n        - text: \",\"\n        - code: \"{children}\"\n        - text: \", and\"\n        - code: className\n        - text: \", for example.\"\n    - listitem:\n      - paragraph:\n        - text: Move any necessary JavaScript, including import statements, into a\n        - link \"\u201ccode fence\u201d (---)\":\n          - /url: /en/basics/astro-components/#the-component-script\n          - text: \u201ccode fence\u201d (\n          - code: \"---\"\n          - text: )\n        - text: \". Note: JavaScript to\"\n        - link \"conditionally render content\":\n          - /url: /en/reference/astro-syntax/#dynamic-html\n        - text: is often written inside the HTML template directly in Astro.\n    - listitem:\n      - paragraph:\n        - text: Use\n        - link \"Astro.props\":\n          - /url: /en/reference/api-reference/#props\n          - code: Astro.props\n        - text: to access any additional props that were previously passed to your Next function.\n    - listitem:\n      - paragraph:\n        - text: Decide whether any imported components also need to be converted to Astro. With the official integration installed, you can\n        - link \"use existing React components in your Astro file\":\n          - /url: /en/guides/framework-components/\n        - text: . But, you may want to convert them to\n        - code: .astro\n        - text: components, especially if they do not need to be interactive!\n    - listitem:\n      - paragraph:\n        - text: Replace\n        - code: getStaticProps()\n        - text: with import statements or\n        - link \"import.meta.glob()\":\n          - /url: /en/guides/imports/#importmetaglob\n          - code: import.meta.glob()\n        - text: to query your local files. Use\n        - code: fetch()\n        - text: to fetch external data.\n  - paragraph:\n    - text: See\n    - link \"an example of a Next .js file converted step-by-step\":\n      - /url: \"#guided-example-next-data-fetching-to-astro\"\n      - text: an example of a Next\n      - code: .js\n      - text: file converted step-by-step\n    - text: .\n  - 'heading \"Compare: JSX vs Astro\" [level=4]'\n  - 'link \"Section titled \u201cCompare: JSX vs Astro\u201d\"':\n    - /url: \"#compare-jsx-vs-astro\"\n  - paragraph: \"Compare the following Next component and a corresponding Astro component:\"\n  - tablist:\n    - tab \"JSX\" [selected]\n    - tab \"Astro\"\n  - tabpanel \"JSX\":\n    - figure \"StarCount.jsx\":\n      - text: StarCount.jsx\n      - region:\n        - code: \"import Header from \\\"./header\\\"; import Footer from \\\"./footer\\\"; import \\\"./layout.css\\\"; export async function getStaticProps() { const res = await fetch(\\\"https://api.github.com/repos/withastro/astro\\\"); const json = await res.json(); return { props: { message: json.message, stars: json.stargazers_count || 0 }, } } const Component = ({ stars, message }) => { return ( <> <Header /> <p style={{ backgroundColor: `#f4f4f4`, padding: `1em 1.5em`, textAlign: `center`, marginBottom: `1em` }}>Astro has {stars} \ud83e\uddd1\u200d\ud83d\ude80</p> <Footer /> </> ) } export default Component;\"\n      - button \"Copy to clipboard\"\n  - heading \"Migrating Layout Files\" [level=3]\n  - link \"Section titled \u201cMigrating Layout Files\u201d\":\n    - /url: \"#migrating-layout-files\"\n  - paragraph:\n    - text: You may find it helpful to start by converting your Next.js layouts and templates into\n    - link \"Astro layout components\":\n      - /url: /en/basics/layouts/\n    - text: .\n  - paragraph: \"Next has two different methods for creating layout files, each of which handles layouts differently than Astro:\"\n  - list:\n    - listitem:\n      - paragraph:\n        - text: The\n        - code: pages\n        - text: directory\n    - listitem:\n      - paragraph:\n        - link \"The /app directory\":\n          - /url: https://nextjs.org/docs/app/building-your-application/routing/pages-and-layouts#layouts\n          - text: The\n          - code: /app\n          - text: directory\n  - paragraph:\n    - text: Each Astro page explicitly requires\n    - code: <html>\n    - text: \",\"\n    - code: <head>\n    - text: \", and\"\n    - code: <body>\n    - text: tags to be present, so it is common to reuse a layout file across pages. Astro uses a\n    - link \"<slot />\":\n      - /url: /en/basics/astro-components/#slots\n      - code: <slot />\n    - text: for page content, with no import statement required. Note the standard HTML templating, and direct access to\n    - code: <head>\n    - text: \":\"\n  - figure \"src/layouts/Layout.astro\":\n    - text: src/layouts/Layout.astro\n    - code: \"--- --- <html lang=\\\"en\\\"> <head> <meta charset=\\\"utf-8\\\" /> <link rel=\\\"icon\\\" type=\\\"image/svg+xml\\\" href=\\\"/favicon.svg\\\" /> <meta name=\\\"viewport\\\" content=\\\"width=device-width\\\" /> <meta name=\\\"generator\\\" content={Astro.generator} /> <title>Astro</title> </head> <body> <!-- Wrap the slot element with your existing layout templating --> <slot /> </body> </html>\"\n    - button \"Copy to clipboard\"\n  - heading \"Migrating from Next.js\u2019 pages directory\" [level=4]:\n    - text: Migrating from Next.js\u2019\n    - code: pages\n    - text: directory\n  - link \"Section titled \u201cMigrating from Next.js\u2019 pages directory\u201d\":\n    - /url: \"#migrating-from-nextjs-pages-directory\"\n  - paragraph:\n    - text: Your Next project may have a\n    - code: pages/_document.jsx\n    - text: file that imports React components to customize your app\u2019s\n    - code: <head>\n    - text: \":\"\n  - figure \"pages/_document.jsx\":\n    - text: pages/_document.jsx\n    - region:\n      - code: \"import Document, { Html, Head, Main, NextScript } from \\\"next/document\\\"; export default class MyDocument extends Document { render() { return ( <Html lang=\\\"en\\\"> <Head> <link rel=\\\"icon\\\" href=\\\"/favicon.ico\\\" /> </Head> <body> <Main /> <NextScript /> </body> </Html> ); } }\"\n    - button \"Copy to clipboard\"\n  - list:\n    - listitem:\n      - paragraph: Make a new Astro layout file using only the returned JSX.\n    - listitem:\n      - paragraph:\n        - text: Replace any React components with\n        - code: <html>\n        - text: \",\"\n        - code: <head>\n        - text: \",\"\n        - code: <slot>\n        - text: \", and other HTML standard tags.\"\n      - figure \"src/layouts/Document.astro\":\n        - text: src/layouts/Document.astro\n        - code: <html lang=\"en\"> <head> <link rel=\"icon\" href=\"/favicon.ico\" /> </head> <body> <slot/> </body> </html>\n        - button \"Copy to clipboard\"\n  - heading \"Migrating from Next.js\u2019 /app directory\" [level=4]:\n    - text: Migrating from Next.js\u2019\n    - code: /app\n    - text: directory\n  - link \"Section titled \u201cMigrating from Next.js\u2019 /app directory\u201d\":\n    - /url: \"#migrating-from-nextjs-app-directory\"\n  - paragraph:\n    - text: Next.js\u2019\n    - code: app/\n    - text: \"directory layout files are created with two files: a\"\n    - code: layout.jsx\n    - text: file to customize the\n    - code: <html>\n    - text: and\n    - code: <body>\n    - text: contents, and a\n    - code: head.jsx\n    - text: file to customize the\n    - code: <head>\n    - text: element contents.\n  - figure \"app/layout.jsx\":\n    - text: app/layout.jsx\n    - code: \"export default function Layout({ children }) { return ( <html lang=\\\"en\\\"> <body>{children}</body> </html> ); }\"\n    - button \"Copy to clipboard\"\n  - figure \"app/head.jsx\":\n    - text: app/head.jsx\n    - code: \"export default function Head() { return ( <> <title>My Page</title> </> ); }\"\n    - button \"Copy to clipboard\"\n  - list:\n    - listitem:\n      - paragraph: Make a new Astro layout file using only the returned JSX.\n    - listitem:\n      - paragraph:\n        - text: Replace both these files with a single Astro layout file that contains a page shell (\n        - code: <html>\n        - text: \",\"\n        - code: <head>\n        - text: \", and\"\n        - code: <body>\n        - text: tags) and a\n        - code: <slot/>\n        - text: instead of React\u2019s\n        - code: \"{children}\"\n        - text: \"prop:\"\n      - figure \"src/layouts/Layout.astro\":\n        - text: src/layouts/Layout.astro\n        - code: <html lang=\"en\"> <head> <title>My Page</title> </head> <body> <slot/> </body> </html>\n        - button \"Copy to clipboard\"\n  - heading \"Migrating Pages and Posts\" [level=3]\n  - link \"Section titled \u201cMigrating Pages and Posts\u201d\":\n    - /url: \"#migrating-pages-and-posts\"\n  - paragraph:\n    - text: In Next.js, your posts either live in\n    - code: /pages\n    - text: or\n    - code: /app/routeName/page.jsx\n    - text: .\n  - paragraph:\n    - text: In Astro, all your page content must live within\n    - code: src/\n    - text: unless you are using\n    - link \"content collections\":\n      - /url: /en/guides/content-collections/\n    - text: .\n  - heading \"React pages\" [level=4]\n  - link \"Section titled \u201cReact pages\u201d\":\n    - /url: \"#react-pages\"\n  - paragraph:\n    - text: Your existing Next JSX (\n    - code: .js\n    - text: ) pages will need to be\n    - link \"converted from JSX files to .astro pages\":\n      - /url: \"#tips-convert-jsx-files-to-astro-files\"\n      - text: converted from JSX files to\n      - code: .astro\n      - text: pages\n    - text: . You cannot use an existing JSX page file in Astro.\n  - paragraph:\n    - text: These\n    - link \".astro pages\":\n      - /url: /en/basics/astro-pages/\n      - code: .astro\n      - text: pages\n    - text: must be located within\n    - code: src/pages/\n    - text: and will have page routes generated automatically based on their file path.\n  - heading \"Markdown and MDX pages\" [level=4]\n  - link \"Section titled \u201cMarkdown and MDX pages\u201d\":\n    - /url: \"#markdown-and-mdx-pages\"\n  - paragraph:\n    - text: Astro has built-in support for Markdown and an optional integration for MDX files. You can reuse any existing\n    - link \"Markdown and MDX files\":\n      - /url: /en/guides/markdown-content/\n    - text: \", but they may require some adjustments to their frontmatter, such as adding\"\n    - link \"Astro\u2019s special layout frontmatter property\":\n      - /url: /en/basics/layouts/#markdown-layouts\n      - text: Astro\u2019s special\n      - code: layout\n      - text: frontmatter property\n    - text: . You will no longer need to manually create pages for each Markdown-generated route. These files can be placed within\n    - code: src/pages/\n    - text: to take advantage of automatic file-based routing.\n  - paragraph:\n    - text: Alternatively, you can use\n    - link \"content collections\":\n      - /url: /en/guides/content-collections/\n    - text: in Astro to store and manage your content. You will retrieve the content yourself and\n    - link \"generate those pages dynamically\":\n      - /url: /en/guides/content-collections/#generating-routes-from-content\n    - text: .\n  - heading \"Migrating Tests\" [level=3]\n  - link \"Section titled \u201cMigrating Tests\u201d\":\n    - /url: \"#migrating-tests\"\n  - paragraph: As Astro outputs raw HTML, it is possible to write end-to-end tests using the output of the build step. Any end-to-end tests written previously might work out-of-the-box if you have been able to match the markup of your Next site. Testing libraries such as Jest and React Testing Library can be imported and used in Astro to test your React components.\n  - paragraph:\n    - text: See Astro\u2019s\n    - link \"testing guide\":\n      - /url: /en/guides/testing/\n    - text: for more.\n  - 'heading \"Reference: Convert Next.js Syntax to Astro\" [level=2]'\n  - 'link \"Section titled \u201cReference: Convert Next.js Syntax to Astro\u201d\"':\n    - /url: \"#reference-convert-nextjs-syntax-to-astro\"\n  - heading \"Next Links to Astro\" [level=3]\n  - link \"Section titled \u201cNext Links to Astro\u201d\":\n    - /url: \"#next-links-to-astro\"\n  - paragraph:\n    - text: Convert any Next\n    - code: <Link to=\"\">\n    - text: \",\"\n    - code: <NavLink>\n    - text: etc. components to HTML\n    - code: <a href=\"\">\n    - text: tags.\n  - figure:\n    - code: \"- <Link to=\\\"/blog\\\">Blog</Link> + <a href=\\\"/blog\\\">Blog</a>\"\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - text: Astro does not use any special component for links, although you are welcome to build your own\n    - code: <Link>\n    - text: component. You can then import and use this\n    - code: <Link>\n    - text: just as you would any other component.\n  - figure \"src/components/Link.astro\":\n    - text: src/components/Link.astro\n    - code: \"--- const { to } = Astro.props; --- <a href={to}><slot /></a>\"\n    - button \"Copy to clipboard\"\n  - heading \"Next Imports to Astro\" [level=3]\n  - link \"Section titled \u201cNext Imports to Astro\u201d\":\n    - /url: \"#next-imports-to-astro\"\n  - paragraph:\n    - text: Update any\n    - link \"file imports\":\n      - /url: /en/guides/imports/\n    - text: to reference relative file paths exactly. This can be done using\n    - link \"import aliases\":\n      - /url: /en/guides/typescript/#import-aliases\n    - text: \", or by writing out a relative path in full.\"\n  - paragraph:\n    - text: Note that\n    - code: .astro\n    - text: and several other file types must be imported with their full file extension.\n  - figure \"src/pages/authors/Fred.astro\":\n    - text: src/pages/authors/Fred.astro\n    - code: \"--- import Card from \\\"../../components/Card.astro\\\"; --- <Card />\"\n    - button \"Copy to clipboard\"\n  - heading \"Next Children Props to Astro\" [level=3]\n  - link \"Section titled \u201cNext Children Props to Astro\u201d\":\n    - /url: \"#next-children-props-to-astro\"\n  - paragraph:\n    - text: Convert any instances of\n    - code: \"{children}\"\n    - text: to an Astro\n    - code: <slot />\n    - text: . Astro does not need to receive\n    - code: \"{children}\"\n    - text: as a function prop and will automatically render child content in a\n    - code: <slot />\n    - text: .\n  - figure \"src/components/MyComponent.astro\":\n    - text: src/components/MyComponent.astro\n    - code: \"--- --- - export default function MyComponent(props) { - return ( - <div> - {props.children} - </div> - ); - } + <div> + <slot /> + </div>\"\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - text: React components that pass multiple sets of children can be migrated to an Astro component using\n    - link \"named slots\":\n      - /url: /en/basics/astro-components/#named-slots\n    - text: .\n  - paragraph:\n    - text: See more about\n    - link \"specific <slot /> usage in Astro\":\n      - /url: /en/basics/astro-components/#slots\n      - text: specific\n      - code: <slot />\n      - text: usage in Astro\n    - text: .\n  - heading \"Next Data Fetching to Astro\" [level=3]\n  - link \"Section titled \u201cNext Data Fetching to Astro\u201d\":\n    - /url: \"#next-data-fetching-to-astro\"\n  - paragraph:\n    - text: Convert any instances of\n    - code: getStaticProps()\n    - text: to either\n    - code: import.meta.glob()\n    - text: or\n    - code: getCollection()\n    - text: /\n    - code: getEntry()\n    - text: in order to access data from other files in your project source. To\n    - link \"fetch remote data\":\n      - /url: /en/guides/data-fetching/\n    - text: \", use\"\n    - code: fetch()\n    - text: .\n  - paragraph: These data requests are made in the frontmatter of the Astro component and use top-level await.\n  - figure \"src/pages/index.astro\":\n    - text: src/pages/index.astro\n    - region:\n      - code: \"--- import { getCollection } from 'astro:content'; // Get all `src/content/blog/` entries const allBlogPosts = await getCollection('blog'); // Get all `src/pages/posts/` entries const allPosts = Object.values(import.meta.glob('../pages/posts/*.md', { eager: true })); const response = await fetch('https://randomuser.me/api/'); const data = await response.json(); const randomUser = data.results[0]; ---\"\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - text: See more about local files imports with\n    - link \"import.meta.glob()\":\n      - /url: /en/guides/imports/#importmetaglob\n      - code: import.meta.glob()\n    - text: \",\"\n    - link \"querying with content collections\":\n      - /url: /en/guides/content-collections/#querying-build-time-collections\n    - text: or\n    - link \"fetching remote data\":\n      - /url: /en/guides/data-fetching/\n    - text: .\n  - heading \"Next Styling to Astro\" [level=3]\n  - link \"Section titled \u201cNext Styling to Astro\u201d\":\n    - /url: \"#next-styling-to-astro\"\n  - paragraph:\n    - text: You may need to replace any\n    - link \"CSS-in-JS libraries\":\n      - /url: https://github.com/withastro/astro/issues/4432\n    - text: (e.g. styled-components) with other available CSS options in Astro.\n  - paragraph:\n    - text: If necessary, convert any inline style objects (\n    - code: \"style={{ fontWeight: \\\"bold\\\" }}\"\n    - text: ) to inline HTML style attributes (\n    - code: style=\"font-weight:bold;\"\n    - text: ). Or, use an\n    - link \"Astro <style> tag\":\n      - /url: /en/guides/styling/#styling-in-astro\n      - text: Astro\n      - code: <style>\n      - text: tag\n    - text: for scoped CSS styles.\n  - figure \"src/components/Card.astro\":\n    - text: src/components/Card.astro\n    - region:\n      - code: \"- <div style={{backgroundColor: `#f4f4f4`, padding: `1em`}}>{message}</div> + <div style=\\\"background-color: #f4f4f4; padding: 1em;\\\">{message}</div>\"\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - text: Tailwind is supported after installing the\n    - link \"Tailwind Vite plugin\":\n      - /url: /en/guides/styling/#tailwind\n    - text: . No changes to your existing Tailwind code are required!\n  - paragraph:\n    - text: See more about\n    - link \"Styling in Astro\":\n      - /url: /en/guides/styling/\n    - text: .\n  - heading \"Next Image Plugin to Astro\" [level=3]\n  - link \"Section titled \u201cNext Image Plugin to Astro\u201d\":\n    - /url: \"#next-image-plugin-to-astro\"\n  - paragraph:\n    - text: Convert any Next\n    - code: <Image />\n    - text: components to\n    - link \"Astro\u2019s own image component\":\n      - /url: /en/guides/images/\n    - text: in\n    - code: .astro\n    - text: or\n    - code: .mdx\n    - text: files, or to a\n    - link \"standard HTML <img> / JSX <img />\":\n      - /url: /en/guides/images/#images-in-ui-framework-components\n      - text: standard HTML\n      - code: <img>\n      - text: / JSX\n      - code: <img />\n    - text: tag as appropriate in your React components.\n  - paragraph:\n    - text: Astro\u2019s\n    - code: <Image />\n    - text: component works in\n    - code: .astro\n    - text: and\n    - code: .mdx\n    - text: files only. See a\n    - link \"full list of its component attributes\":\n      - /url: /en/reference/modules/astro-assets/#image-\n    - text: and note that several will differ from Next\u2019s attributes.\n  - figure \"src/pages/index.astro\":\n    - text: src/pages/index.astro\n    - code: \"--- import { Image } from 'astro:assets'; import rocket from '../assets/rocket.png'; --- <Image src={rocket} alt=\\\"A rocketship in space.\\\" /> <img src={rocket.src} alt=\\\"A rocketship in space.\\\">\"\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - text: In React (\n    - code: .jsx\n    - text: ) components, use standard JSX image syntax (\n    - code: <img />\n    - text: ). Astro will not optimize these images, but you can install and use NPM packages for more flexibility.\n  - paragraph:\n    - text: You can learn more about\n    - link \"using images in Astro\":\n      - /url: /en/guides/images/\n    - text: in the Images Guide.\n  - 'heading \"Guided example: Next data fetching to Astro\" [level=2]'\n  - 'link \"Section titled \u201cGuided example: Next data fetching to Astro\u201d\"':\n    - /url: \"#guided-example-next-data-fetching-to-astro\"\n  - paragraph: Here is an example of Next.js Pok\u00e9dex data fetch converted to Astro.\n  - paragraph:\n    - code: pages/index.js\n    - text: fetches and displays a list of the first 151 Pok\u00e9mon using\n    - link \"the REST Pok\u00e9API\":\n      - /url: https://pokeapi.co/\n    - text: .\n  - paragraph:\n    - text: Here\u2019s how to recreate that in\n    - code: src/pages/index.astro\n    - text: \", replacing\"\n    - code: getStaticProps()\n    - text: with\n    - code: fetch()\n    - text: .\n  - list:\n    - listitem:\n      - paragraph: Identify the return() JSX.\n      - figure \"pages/index.js\":\n        - text: pages/index.js\n        - region:\n          - code: \"import Link from 'next/link' import styles from '../styles/poke-list.module.css'; export default function Home({ pokemons }) { return ( <> <ul className={`plain-list ${styles.pokeList}`}> {pokemons.map((pokemon) => ( <li className={styles.pokemonListItem} key={pokemon.name}> <Link className={styles.pokemonContainer} as={`/pokemon/${pokemon.name}`} href=\\\"/pokemon/[name]\\\"> <p className={styles.pokemonId}>No. {pokemon.id}</p> <img className={styles.pokemonImage} src={`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${pokemon.id}.png`} alt={`${pokemon.name} picture`}></img> <h2 className={styles.pokemonName}>{pokemon.name}</h2> </Link> </li> ))} </ul> </> ) } export const getStaticProps = async () => { const res = await fetch(\\\"https://pokeapi.co/api/v2/pokemon?limit=151\\\") const resJson = await res.json(); const pokemons = resJson.results.map(pokemon => { const name = pokemon.name; // https://pokeapi.co/api/v2/pokemon/1/ const url = pokemon.url; const id = url.split(\\\"/\\\")[url.split(\\\"/\\\").length - 2]; return { name, url, id } }); return { props: { pokemons, }, } }\"\n        - button \"Copy to clipboard\"\n    - listitem:\n      - paragraph:\n        - text: Create\n        - code: src/pages/index.astro\n      - paragraph:\n        - text: Use the return value of the Next function. Convert any Next or React syntax to Astro, including changing the case of any\n        - link \"HTML global attributes\":\n          - /url: https://developer.mozilla.org/en-US/docs/Web/HTML/Global_attributes\n        - text: .\n      - paragraph: \"Note that:\"\n      - list:\n        - listitem:\n          - paragraph:\n            - code: .map\n            - text: just works!\n        - listitem:\n          - paragraph:\n            - code: className\n            - text: becomes\n            - code: class\n            - text: .\n        - listitem:\n          - paragraph:\n            - code: <Link>\n            - text: becomes\n            - code: <a>\n            - text: .\n        - listitem:\n          - paragraph:\n            - text: The\n            - code: <> </>\n            - text: fragment is not required in Astro templating.\n        - listitem:\n          - paragraph:\n            - code: key\n            - text: is a React attribute, and is not an attribute of\n            - code: li\n            - text: in Astro.\n      - figure \"src/pages/index.astro\":\n        - text: src/pages/index.astro\n        - region:\n          - code:\n            - text: \"--- --- <ul\"\n            - mark: class\n            - text: \"=\\\"plain-list pokeList\\\"> { pokemons.map((pokemon: any) => ( <li\"\n            - mark: class\n            - text: =\"pokemonListItem\">\n            - mark: <a\n            - mark: class\n            - text: \"=\\\"pokemonContainer\\\" href={`/pokemon/${pokemon.name}`}> <p\"\n            - mark: class\n            - text: \"=\\\"pokemonId\\\">No. {pokemon.id}</p> <img\"\n            - mark: class\n            - text: \"=\\\"pokemonImage\\\" src={`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${pokemon.id}.png`} alt={`${pokemon.name} picture`} /> <h2\"\n            - mark: class\n            - text: \"=\\\"pokemonName\\\">{pokemon.name}</h2>\"\n            - mark: </a>\n            - text: \"</li> )) } </ul>\"\n        - button \"Copy to clipboard\"\n    - listitem:\n      - paragraph: Add any needed imports, props, and JavaScript\n      - paragraph: \"Note that:\"\n      - list:\n        - listitem:\n          - text: the\n          - code: getStaticProps\n          - text: function is no longer needed. Data from the API is fetched directly in the code fence.\n        - listitem:\n          - text: A\n          - code: <Layout>\n          - text: component is imported and wraps the page templating.\n      - figure \"src/pages/index.astro\":\n        - text: src/pages/index.astro\n        - region:\n          - code: \"--- + import Layout from \\\"../layouts/layout.astro\\\"; + const res = await fetch(\\\"https://pokeapi.co/api/v2/pokemon?limit=151\\\"); + const resJson = await res.json(); + const pokemons = resJson.results.map((pokemon: any) => { + const name = pokemon.name; + // https://pokeapi.co/api/v2/pokemon/1/ + const url = pokemon.url; + const id = url.split(\\\"/\\\")[url.split(\\\"/\\\").length - 2]; + return { + name, + url, + id, + }; + }); --- + <Layout> <ul class=\\\"plain-list pokeList\\\"> { pokemons.map((pokemon: any) => ( <li class=\\\"pokemonListItem\\\"> <a class=\\\"pokemonContainer\\\" href={`/pokemon/${pokemon.name}`}> <p class=\\\"pokemonId\\\">No. {pokemon.id}</p> <img class=\\\"pokemonImage\\\" src={`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${pokemon.id}.png`} alt={`${pokemon.name} picture`} /> <h2 class=\\\"pokemonName\\\">{pokemon.name}</h2> </a> </li> )) } </ul> + </Layout>\"\n        - button \"Copy to clipboard\"\n  - heading \"Community Resources\" [level=2]\n  - link \"Section titled \u201cCommunity Resources\u201d\":\n    - /url: \"#community-resources\"\n  - link \"Why we switched to Astro (and why it might interest you)\":\n    - /url: https://www.datocms.com/blog/why-we-switched-to-astro\n  - link \"Migrating from Next.js to Astro\":\n    - /url: https://johnzanussi.com/posts/nextjs-to-astro-migration\n  - link \"From NextJS to Astro\":\n    - /url: https://vanntile.com/blog/next-to-astro\n  - link \"Converting Next.js to Astro\":\n    - /url: https://ericclemmons.com/blog/converting-nextjs-to-astro\n  - link \"Migrating to Astro (from Next.js)\":\n    - /url: https://www.raygesualdo.com/posts/migrating-to-astro-the-beginning/\n  - link \"Astro.js as an alternative to Next.js\":\n    - /url: https://www.railyard.works/blog/astro-as-alternative-to-next\n  - link \"Why I Switched My Website from Next.js to Astro\":\n    - /url: https://praveenjuge.com/blog/why-i-switched-my-website-from-nextjs-to-astro/\n  - 'link \"NextJS to Astro: more control = faster sites\"':\n    - /url: https://www.youtube.com/watch?v=PSzCtdM20Fc\n  - link \"How Astro made my site 100x faster\":\n    - /url: https://www.youtube.com/watch?v=cOxA3kMYtkM\n  - complementary \"Have a resource to share?\":\n    - paragraph:\n      - text: If you found (or made!) a helpful video or blog post about converting a Next.js site to Astro,\n      - link \"add it to this list\":\n        - /url: https://github.com/withastro/docs/edit/main/src/content/docs/en/guides/migrate-to-astro/from-nextjs.mdx\n      - text: \"!\"\n  - heading \"More migration guides\" [level=2]\n  - list:\n    - listitem:\n      - heading \"Create React App\" [level=3]:\n        - link \"Create React App\":\n          - /url: /en/guides/migrate-to-astro/from-create-react-app/\n    - listitem:\n      - heading \"Docusaurus\" [level=3]:\n        - link \"Docusaurus\":\n          - /url: /en/guides/migrate-to-astro/from-docusaurus/\n    - listitem:\n      - heading \"Eleventy\" [level=3]:\n        - link \"Eleventy\":\n          - /url: /en/guides/migrate-to-astro/from-eleventy/\n    - listitem:\n      - heading \"Gatsby\" [level=3]:\n        - link \"Gatsby\":\n          - /url: /en/guides/migrate-to-astro/from-gatsby/\n    - listitem:\n      - heading \"GitBook\" [level=3]:\n        - link \"GitBook\":\n          - /url: /en/guides/migrate-to-astro/from-gitbook/\n    - listitem:\n      - heading \"Gridsome\" [level=3]:\n        - link \"Gridsome\":\n          - /url: /en/guides/migrate-to-astro/from-gridsome/\n    - listitem:\n      - heading \"Hugo\" [level=3]:\n        - link \"Hugo\":\n          - /url: /en/guides/migrate-to-astro/from-hugo/\n    - listitem:\n      - heading \"Jekyll\" [level=3]:\n        - link \"Jekyll\":\n          - /url: /en/guides/migrate-to-astro/from-jekyll/\n    - listitem:\n      - heading \"Next.js\" [level=3]:\n        - link \"Next.js\":\n          - /url: /en/guides/migrate-to-astro/from-nextjs/\n    - listitem:\n      - heading \"NuxtJS\" [level=3]:\n        - link \"NuxtJS\":\n          - /url: /en/guides/migrate-to-astro/from-nuxtjs/\n    - listitem:\n      - heading \"Pelican\" [level=3]:\n        - link \"Pelican\":\n          - /url: /en/guides/migrate-to-astro/from-pelican/\n    - listitem:\n      - heading \"SvelteKit\" [level=3]:\n        - link \"SvelteKit\":\n          - /url: /en/guides/migrate-to-astro/from-sveltekit/\n    - listitem:\n      - heading \"VuePress\" [level=3]:\n        - link \"VuePress\":\n          - 