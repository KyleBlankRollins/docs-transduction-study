"- link \"Skip to content\":\n  - /url: \"#_top\"\n- banner:\n  - link \"Astro\":\n    - /url: https://astro.build/\n    - img\n  - link \"Docs\":\n    - /url: /en/getting-started/\n    - img\n  - button \"Search\":\n    - img\n    - text: Search\n  - link \"GitHub\":\n    - /url: https://github.com/withastro/astro\n  - link \"Discord\":\n    - /url: https://astro.build/chat\n  - text: Select theme\n  - combobox \"Select theme\":\n    - option \"Dark\"\n    - option \"Light\"\n    - option \"Auto\" [selected]\n  - text: Select language\n  - combobox \"Select language\":\n    - option \"English\" [selected]\n    - option \"Deutsch\"\n    - option \"Portugu\u00eas do Brasil\"\n    - option \"Espa\u00f1ol\"\n    - option \"\u7b80\u4f53\u4e2d\u6587\"\n    - option \"\u6b63\u9ad4\u4e2d\u6587\"\n    - option \"Fran\u00e7ais\"\n    - option \"\u0939\u093f\u0928\u094d\u0926\u0940\"\n    - option \"\u0627\u0644\u0639\u0631\u0628\u064a\u0629\"\n    - option \"\u65e5\u672c\u8a9e\"\n    - option \"\ud55c\uad6d\uc5b4\"\n    - option \"Polski\"\n    - option \"\u0420\u0443\u0441\u0441\u043a\u0438\u0439\"\n    - option \"Italiano\"\n- navigation \"Main\":\n  - tablist:\n    - tab \"Tutorial\"\n    - tab \"Guide\"\n    - tab \"Reference\"\n    - tab \"Ecosystem\" [selected]\n  - tabpanel \"Ecosystem\":\n    - list:\n      - listitem:\n        - group: UI frameworks\n      - listitem:\n        - group: Adapters\n      - listitem:\n        - group: Other official integrations\n      - listitem:\n        - group: Deployment guides\n      - listitem:\n        - group:\n          - text: Content management systems\n          - list:\n            - listitem:\n              - link \"CMS overview\":\n                - /url: /en/guides/cms/\n            - listitem:\n              - link \"ApostropheCMS\":\n                - /url: /en/guides/cms/apostrophecms/\n            - listitem:\n              - link \"Builder.io\":\n                - /url: /en/guides/cms/builderio/\n            - listitem:\n              - link \"ButterCMS\":\n                - /url: /en/guides/cms/buttercms/\n            - listitem:\n              - link \"Caisy\":\n                - /url: /en/guides/cms/caisy/\n            - listitem:\n              - link \"CloudCannon\":\n                - /url: /en/guides/cms/cloudcannon/\n            - listitem:\n              - link \"Contentful\":\n                - /url: /en/guides/cms/contentful/\n            - listitem:\n              - link \"Cosmic\":\n                - /url: /en/guides/cms/cosmic/\n            - listitem:\n              - link \"Craft CMS\":\n                - /url: /en/guides/cms/craft-cms/\n            - listitem:\n              - link \"Craft Cross CMS\":\n                - /url: /en/guides/cms/craft-cross-cms/\n            - listitem:\n              - link \"Crystallize\":\n                - /url: /en/guides/cms/crystallize/\n            - listitem:\n              - link \"DatoCMS\":\n                - /url: /en/guides/cms/datocms/\n            - listitem:\n              - link \"Decap CMS\":\n                - /url: /en/guides/cms/decap-cms/\n            - listitem:\n              - link \"Directus\":\n                - /url: /en/guides/cms/directus/\n            - listitem:\n              - link \"Drupal\":\n                - /url: /en/guides/cms/drupal/\n            - listitem:\n              - link \"Flotiq\":\n                - /url: /en/guides/cms/flotiq/\n            - listitem:\n              - link \"Front Matter CMS\":\n                - /url: /en/guides/cms/frontmatter-cms/\n            - listitem:\n              - link \"Ghost\":\n                - /url: /en/guides/cms/ghost/\n            - listitem:\n              - link \"GitCMS\":\n                - /url: /en/guides/cms/gitcms/\n            - listitem:\n              - link \"Hashnode\":\n                - /url: /en/guides/cms/hashnode/\n            - listitem:\n              - link \"Hygraph\":\n                - /url: /en/guides/cms/hygraph/\n            - listitem:\n              - link \"JekyllPad\":\n                - /url: /en/guides/cms/jekyllpad/\n            - listitem:\n              - link \"Keystatic\":\n                - /url: /en/guides/cms/keystatic/\n            - listitem:\n              - link \"KeystoneJS\":\n                - /url: /en/guides/cms/keystonejs/\n            - listitem:\n              - link \"Kontent.ai\":\n                - /url: /en/guides/cms/kontent-ai/\n            - listitem:\n              - link \"microCMS\":\n                - /url: /en/guides/cms/microcms/\n            - listitem:\n              - link \"Optimizely CMS\":\n                - /url: /en/guides/cms/optimizely/\n            - listitem:\n              - link \"Pages CMS\":\n                - /url: /en/guides/cms/pages-cms/\n            - listitem:\n              - link \"Payload CMS\":\n                - /url: /en/guides/cms/payload/\n            - listitem:\n              - link \"Prepr CMS\":\n                - /url: /en/guides/cms/preprcms/\n            - listitem:\n              - link \"Prismic\":\n                - /url: /en/guides/cms/prismic/\n            - listitem:\n              - link \"Sanity\":\n                - /url: /en/guides/cms/sanity/\n            - listitem:\n              - link \"Sitecore XM\":\n                - /url: /en/guides/cms/sitecore/\n            - listitem:\n              - link \"Sitepins\":\n                - /url: /en/guides/cms/sitepins/\n            - listitem:\n              - link \"Spinal\":\n                - /url: /en/guides/cms/spinal/\n            - listitem:\n              - link \"Statamic\":\n                - /url: /en/guides/cms/statamic/\n            - listitem:\n              - link \"Storyblok\":\n                - /url: /en/guides/cms/storyblok/\n            - listitem:\n              - link \"Strapi\":\n                - /url: /en/guides/cms/strapi/\n            - listitem:\n              - link \"StudioCMS\":\n                - /url: /en/guides/cms/studiocms/\n            - listitem:\n              - link \"TinaCMS\":\n                - /url: /en/guides/cms/tina-cms/\n            - listitem:\n              - link \"Umbraco\":\n                - /url: /en/guides/cms/umbraco/\n            - listitem:\n              - link \"Vault CMS\":\n                - /url: /en/guides/cms/vault-cms/\n            - listitem:\n              - link \"Wordpress\":\n                - /url: /en/guides/cms/wordpress/\n            - listitem:\n              - link \"Zero\":\n                - /url: /en/guides/cms/zero/\n      - listitem:\n        - group: Backend services\n      - listitem:\n        - group: Image and video hosting\n      - listitem:\n        - link \"E-commerce\":\n          - /url: /en/guides/ecommerce/\n      - listitem:\n        - link \"Authentication\":\n          - /url: /en/guides/authentication/\n      - listitem:\n        - link \"Testing\":\n          - /url: /en/guides/testing/\n  - heading \"Sponsored by\" [level=2]\n  - link \"Netlify\":\n    - /url: https://www.netlify.com/?utm_campaign=Astro-2024&utm_source=astro-referral\n  - link \"Webflow\":\n    - /url: https://webflow.com/feature/cloud?utm_source=Astro&utm_medium=tech-partner&utm_campaign=fy26-astro&utm_content=fy26-docs\n  - link \"Cloudflare\":\n    - /url: https://www.cloudflare.com/?utm_source=astro&utm_medium=astro&utm_campaign=astro\n  - link \"Mux\":\n    - /url: https://www.mux.com/?utm_campaign=21819274-Astro&utm_source=astro\n  - link \"Image Kit\":\n    - /url: https://imagekit.io/?utm_source=astro&utm_medium=astro&utm_campaign=astro\n  - link \"Mintlify\":\n    - /url: https://www.mintlify.com/?utm_source=astro&utm_medium=astro&utm_campaign=astro\n- complementary:\n  - navigation \"On this page\":\n    - heading \"On this page\" [level=2]\n    - list:\n      - listitem:\n        - link \"Overview\":\n          - /url: \"#_top\"\n      - listitem:\n        - link \"Setting up credentials\":\n          - /url: \"#setting-up-credentials\"\n      - listitem:\n        - link \"Making a blog with Astro and Builder\":\n          - /url: \"#making-a-blog-with-astro-and-builder\"\n        - list:\n          - listitem:\n            - link \"Creating a model for a blog post\":\n              - /url: \"#creating-a-model-for-a-blog-post\"\n          - listitem:\n            - link \"Setting up the preview\":\n              - /url: \"#setting-up-the-preview\"\n          - listitem:\n            - link \"Creating a blog post\":\n              - /url: \"#creating-a-blog-post\"\n          - listitem:\n            - link \"Displaying a list of blog posts\":\n              - /url: \"#displaying-a-list-of-blog-posts\"\n          - listitem:\n            - link \"Displaying a single blog post\":\n              - /url: \"#displaying-a-single-blog-post\"\n          - listitem:\n            - link \"Publishing your site\":\n              - /url: \"#publishing-your-site\"\n      - listitem:\n        - link \"Official resources\":\n          - /url: \"#official-resources\"\n      - listitem:\n        - link \"Community resources\":\n          - /url: \"#community-resources\"\n  - complementary \"Learn Astro with James Q Quick\":\n    - img \"Scrimba\"\n    - heading \"Learn Astro with James Q Quick\" [level=2]:\n      - strong: Learn Astro\n      - text: with James Q Quick\n    - paragraph: Build your first site with 35 interactive Scrimba lessons\n    - link \"Get 20% off\":\n      - /url: https://scrimba.com/intro-to-astro-c00ar0fi5u?via=astro\n- main:\n  - heading \"Builder.io & Astro\" [level=1]\n  - paragraph:\n    - link \"Builder.io\":\n      - /url: https://www.builder.io/\n    - text: is a visual CMS that supports drag-and-drop content editing for building websites.\n  - paragraph: This recipe will show you how to connect your Builder space to Astro with zero client-side JavaScript.\n  - paragraph: \"Before you begin, you need the following:\"\n  - paragraph: \"To get started, you will need to have the following:\"\n  - list:\n    - listitem:\n      - strong: A Builder account and space\n      - text: \"- If you don\u2019t have an account yet,\"\n      - link \"sign up for free\":\n        - /url: https://www.builder.io/\n      - text: and create a new space. If you already have a space with Builder, feel free to use it, but you will need to modify the code to match the model name (\n      - code: blogpost\n      - text: ) and custom data fields.\n    - listitem:\n      - strong: A Builder API key\n      - text: \"- This public key will be used to fetch your content from Builder.\"\n      - link \"Read Builder\u2019s guide on how to find your key\":\n        - /url: https://www.builder.io/c/docs/using-your-api-key#finding-your-public-api-key\n      - text: .\n  - heading \"Setting up credentials\" [level=2]\n  - link \"Section titled \u201cSetting up credentials\u201d\":\n    - /url: \"#setting-up-credentials\"\n  - paragraph:\n    - text: To add your Builder API key and your Builder model name to Astro, create a\n    - code: .env\n    - text: \"file in the root of your project (if one does not already exist) and add the following variables:\"\n  - figure \".env\":\n    - text: .env\n    - code: BUILDER_API_PUBLIC_KEY=YOUR_API_KEY BUILDER_BLOGPOST_MODEL='blogpost'\n    - button \"Copy to clipboard\"\n  - paragraph: Now, you should be able to use this API key in your project.\n  - paragraph:\n    - text: \"Note: At the time of writing,\"\n    - link \"this key is public\":\n      - /url: https://www.builder.io/c/docs/using-your-api-key#prerequisites\n    - text: \", so you don\u2019t have to worry about hiding or encrypting it.\"\n  - paragraph:\n    - text: If you would like to have IntelliSense for your environment variables, you can create a\n    - code: env.d.ts\n    - text: file in the\n    - code: src/\n    - text: directory and configure\n    - code: ImportMetaEnv\n    - text: \"like this:\"\n  - figure \"src/env.d.ts\":\n    - text: src/env.d.ts\n    - code: \"interface ImportMetaEnv { readonly BUILDER_API_PUBLIC_KEY: string; }\"\n    - button \"Copy to clipboard\"\n  - paragraph: \"Your project should now include these files:\"\n  - list:\n    - listitem:\n      - group:\n        - text: Directory src/\n        - list:\n          - listitem:\n            - strong: env.d.ts\n    - listitem:\n      - strong: .env\n    - listitem: astro.config.mjs\n    - listitem: package.json\n  - text: Learn more about\n  - link \"environment variables\":\n    - /url: /en/guides/environment-variables/\n  - text: and\n  - code: .env\n  - text: files in Astro.\n  - heading \"Making a blog with Astro and Builder\" [level=2]\n  - link \"Section titled \u201cMaking a blog with Astro and Builder\u201d\":\n    - /url: \"#making-a-blog-with-astro-and-builder\"\n  - heading \"Creating a model for a blog post\" [level=3]\n  - link \"Section titled \u201cCreating a model for a blog post\u201d\":\n    - /url: \"#creating-a-model-for-a-blog-post\"\n  - paragraph:\n    - text: \"The instructions below create an Astro blog using a Builder model (Type: \u201cSection\u201d) called\"\n    - code: blogpost\n    - text: \"that contains two required text fields:\"\n    - code: title\n    - text: and\n    - code: slug\n    - text: .\n  - paragraph:\n    - text: \"For visual types: You can find videos showing this procedure in one of\"\n    - link \"Builder\u2019s official tutorials\":\n      - /url: https://www.builder.io/blog/creating-blog#creating-a-blog-article-model\n    - text: .\n  - paragraph:\n    - text: \"In the Builder app create the model that will represent a blog post: go to the\"\n    - strong: Models\n    - text: tab and click the\n    - strong: + Create Model\n    - text: \"button to create model with the following fields and values:\"\n  - list:\n    - listitem:\n      - strong: \"Type:\"\n      - text: Section\n    - listitem:\n      - strong: \"Name:\"\n      - text: \u201cblogpost\u201d\n    - listitem:\n      - strong: \"Description:\"\n      - text: \u201cThis model is for a blog post\u201d\n  - paragraph:\n    - text: In your new model use the\n    - strong: + New Custom Field\n    - text: \"button to create 2 new fields:\"\n  - list:\n    - listitem:\n      - paragraph: Text field\n      - list:\n        - listitem:\n          - strong: \"Name:\"\n          - text: \u201ctitle\u201d\n        - listitem:\n          - strong: \"Required:\"\n          - text: \"Yes\"\n        - listitem:\n          - strong: Default value\n          - text: \u201cI forgot to give this a title\u201d\n      - paragraph: (leave the other parameters as their defaults)\n    - listitem:\n      - paragraph: Text field\n      - list:\n        - listitem:\n          - strong: \"Name:\"\n          - text: \u201cslug\u201d\n        - listitem:\n          - strong: \"Required:\"\n          - text: \"Yes\"\n        - listitem:\n          - strong: Default value\n          - text: \u201csome-slugs-take-their-time\u201d\n      - paragraph: (leave the other parameters as their defaults)\n  - paragraph:\n    - text: Then click the\n    - strong: Save\n    - text: button in the upper right.\n  - paragraph:\n    - text: \"Slugs: There are some pitfalls with the\"\n    - code: slug\n    - text: \"field:\"\n  - list:\n    - listitem:\n      - paragraph: Make sure your slug is not just a number. This seems to break the fetch request to Builder\u2019s API.\n    - listitem:\n      - paragraph: Make sure your slugs are unique, since your site\u2019s routing will depend on that.\n  - heading \"Setting up the preview\" [level=3]\n  - link \"Section titled \u201cSetting up the preview\u201d\":\n    - /url: \"#setting-up-the-preview\"\n  - paragraph:\n    - text: To use Builder\u2019s visual editor, create the page\n    - code: src/pages/builder-preview.astro\n    - text: that will render the special\n    - code: <builder-component>\n    - text: \":\"\n  - list:\n    - listitem:\n      - group:\n        - text: Directory src/\n        - list:\n          - listitem:\n            - group:\n              - text: Directory pages/\n              - list:\n                - listitem:\n                  - strong: builder-preview.astro\n          - listitem: env.d.ts\n    - listitem: .env\n    - listitem: astro.config.mjs\n    - listitem: package.json\n  - paragraph: \"Then add the following content:\"\n  - figure \"src/pages/builder-preview.astro\":\n    - text: src/pages/builder-preview.astro\n    - code: \"--- const builderAPIpublicKey = import.meta.env.BUILDER_API_PUBLIC_KEY; const builderModel = import.meta.env.BUILDER_BLOGPOST_MODEL; --- <html lang=\\\"en\\\"> <head> <title>Preview for builder.io</title> </head> <body> <header>This is your header</header> <builder-component model={builderModel} api-key={builderAPIpublicKey} ></builder-component> <script async src=\\\"https://cdn.builder.io/js/webcomponents\\\"></script> <footer>This is your footer</footer> </body> </html>\"\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - text: In the above example,\n    - code: <builder-component>\n    - text: tells Builder where to insert the content from its CMS.\n  - heading \"Setting the new route as the preview URL\" [level=4]\n  - link \"Section titled \u201cSetting the new route as the preview URL\u201d\":\n    - /url: \"#setting-the-new-route-as-the-preview-url\"\n  - paragraph: Complete the following steps in order.\n  - paragraph:\n    - text: First, Copy the full URL of your preview, including the protocol, to your clipboard (e.g.\n    - code: \"https://{your host}/builder-preview\"\n    - text: ).\n  - paragraph:\n    - text: Second, Go to the\n    - strong: Models\n    - text: tab in your Builder space, pick the model you\u2019ve created and paste the URL from step 1 into the\n    - strong: Preview URL\n    - text: field. Make sure the URL is complete and includes the protocol, for example\n    - code: https://\n    - text: .\n  - paragraph:\n    - text: Finally, Click the\n    - strong: Save\n    - text: button in the upper right.\n  - paragraph:\n    - text: As a helpful tip, When you deploy your site, change the preview URL to match your production URL, for example\n    - code: https://myAwesomeAstroBlog.com/builder-preview\n    - text: .\n  - heading \"Testing the preview URL setup\" [level=4]\n  - link \"Section titled \u201cTesting the preview URL setup\u201d\":\n    - /url: \"#testing-the-preview-url-setup\"\n  - paragraph: Complete the following steps in order.\n  - paragraph:\n    - text: First, Make sure your site is live (e.g. your dev server is running) and the\n    - code: /builder-preview\n    - text: route is working.\n  - paragraph:\n    - text: Second, In your Builder space under the\n    - strong: Content\n    - text: tab, click on\n    - strong: New\n    - text: to create a new content entry for your\n    - code: blogpost\n    - text: model.\n  - paragraph:\n    - text: Finally, In the Builder editor that just opened, you should be able to see the\n    - code: builder-preview.astro\n    - text: page with a big\n    - strong: Add Block\n    - text: in the middle.\n  - paragraph: \"Troubleshooting: Things can sometimes go wrong when setting up the preview. If something\u2019s not right, you can try one of these things:\"\n  - list:\n    - listitem: Make sure the site is live - for example, your dev server is running.\n    - listitem: Make sure that the URLs match exactly - the one in your Astro project and the one set in the Builder app.\n    - listitem:\n      - text: Make sure it\u2019s the full URL including the protocol, for example\n      - code: https://\n      - text: .\n    - listitem:\n      - text: If you\u2019re working in a virtual environment like\n      - link \"StackBlitz\":\n        - /url: https://stackblitz.com/\n      - text: \", you might have to copy and paste the URL again when you restart your workspace, since this usually generates a new URL for your project.\"\n  - paragraph:\n    - text: For more ideas, read\n    - link \"Builder\u2019s troubleshooting guide\":\n      - /url: https://www.builder.io/c/docs/guides/preview-url-working\n    - text: .\n  - heading \"Creating a blog post\" [level=3]\n  - link \"Section titled \u201cCreating a blog post\u201d\":\n    - /url: \"#creating-a-blog-post\"\n  - paragraph: Complete the following steps in order.\n  - paragraph: \"First, In Builder\u2019s visual editor, create a new content entry with the following values:\"\n  - list:\n    - listitem:\n      - strong: \"title:\"\n      - text: \u2018First post, woohoo!\u2019\n    - listitem:\n      - strong: \"slug:\"\n      - text: \u2018first-post-woohoo\u2019\n  - paragraph:\n    - text: Second, Complete your post using the\n    - strong: Add Block\n    - text: button and add a text field with some post content.\n  - paragraph: Third, In the text field above the editor, give your entry a name. This is how it will be listed in the Builder app.\n  - paragraph:\n    - text: Fourth, When you\u2019re ready click the\n    - strong: Publish\n    - text: button in the upper right corner.\n  - paragraph:\n    - text: Finally, Create as many posts as you like, ensuring that all content entries contain a\n    - code: title\n    - text: and a\n    - code: slug\n    - text: as well as some post content.\n  - heading \"Displaying a list of blog posts\" [level=3]\n  - link \"Section titled \u201cDisplaying a list of blog posts\u201d\":\n    - /url: \"#displaying-a-list-of-blog-posts\"\n  - paragraph:\n    - text: Add the following content to\n    - code: src/pages/index.astro\n    - text: \"in order to fetch and display a list of all post titles, each linking to its own page:\"\n  - figure \"src/pages/index.astro\":\n    - text: src/pages/index.astro\n    - region:\n      - code: \"--- const builderAPIpublicKey = import.meta.env.BUILDER_API_PUBLIC_KEY; const builderModel = import.meta.env.BUILDER_BLOGPOST_MODEL; const { results: posts } = await fetch( `https://cdn.builder.io/api/v3/content/${builderModel}?${new URLSearchParams({ apiKey: builderAPIpublicKey, fields: [\\\"data.slug\\\", \\\"data.title\\\"].join(\\\",\\\"), cachebust: \\\"true\\\", }).toString()}` ) .then((res) => res.json()) .catch(); --- <html lang=\\\"en\\\"> <head> <title>Blog Index</title> </head> <body> <ul> { posts.flatMap(({ data: { slug, title } }) => ( <li> <a href={`/posts/${slug}`}>{title}</a> </li> )) } </ul> </body> </html>\"\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - text: Fetching via the content API returns an array of objects containing data for each post. The\n    - code: fields\n    - text: query parameter tells Builder which data is included (see highlighted code).\n    - code: slug\n    - text: and\n    - code: title\n    - text: should match the names of the custom data fields you\u2019ve added to your Builder model.\n  - paragraph:\n    - text: The\n    - code: posts\n    - text: array returned from the fetch displays a list of blog post titles on the home page. The individual page routes will be created in the next step.\n  - paragraph:\n    - text: \"Framework integrations: If you are using a JavaScript framework (e.g. Svelte, Vue, or React) in your Astro project you can use\"\n    - link \"one of Builder\u2019s integrations\":\n      - /url: https://www.builder.io/m/integrations\n    - text: as an alternative to making raw fetch calls through the REST API.\n  - paragraph: Go to your index route and you should be able to see a list of links each with the title of a blog post!\n  - heading \"Displaying a single blog post\" [level=3]\n  - link \"Section titled \u201cDisplaying a single blog post\u201d\":\n    - /url: \"#displaying-a-single-blog-post\"\n  - paragraph:\n    - text: Create the page\n    - code: src/pages/posts/[slug].astro\n    - text: that will\n    - link \"dynamically generate a page\":\n      - /url: /en/guides/routing/#dynamic-routes\n    - text: for each post.\n  - list:\n    - listitem:\n      - group:\n        - text: Directory src/\n        - list:\n          - listitem:\n            - group:\n              - text: Directory pages/\n              - list:\n                - listitem: index.astro\n                - listitem:\n                  - group:\n                    - text: Directory posts/\n                    - list:\n                      - listitem:\n                        - strong: \"[slug].astro\"\n          - listitem: env.d.ts\n    - listitem: .env\n    - listitem: astro.config.mjs\n    - listitem: package.json\n  - paragraph: \"This file must contain:\"\n  - list:\n    - listitem:\n      - text: A\n      - link \"getStaticPaths()\":\n        - /url: /en/reference/routing-reference/#getstaticpaths\n        - code: getStaticPaths()\n      - text: function to fetch\n      - code: slug\n      - text: information from Builder and create a static route for each blog post.\n    - listitem:\n      - text: A\n      - code: fetch()\n      - text: to the Builder API using the\n      - code: slug\n      - text: identifier to return post content and metadata (e.g. a\n      - code: title\n      - text: ).\n    - listitem:\n      - text: A\n      - code: <Fragment />\n      - text: in the template to render the post content as HTML.\n  - paragraph: Each of these is highlighted in the following code snippet.\n  - figure \"src/pages/posts/[slug].astro\":\n    - text: src/pages/posts/[slug].astro\n    - region:\n      - code: \"--- + export async function getStaticPaths() { const builderModel = import.meta.env.BUILDER_BLOGPOST_MODEL; const builderAPIpublicKey = import.meta.env.BUILDER_API_PUBLIC_KEY; const { results: posts } = await fetch( `https://cdn.builder.io/api/v3/content/${builderModel}?${new URLSearchParams( { apiKey: builderAPIpublicKey, fields: [\\\"data.slug\\\", \\\"data.title\\\"].join(\\\",\\\"), cachebust: \\\"true\\\", } ).toString()}` ) .then((res) => res.json()) .catch // ...catch some errors...); (); return posts.map(({ data: { slug, title } }) => ({ params: { slug }, props: { title }, })) } const { slug } = Astro.params; const { title } = Astro.props; const builderModel = import.meta.env.BUILDER_BLOGPOST_MODEL; + const builderAPIpublicKey = import.meta.env.BUILDER_API_PUBLIC_KEY; // Builder's API requires this field but for this use case the url doesn't seem to matter - the API returns the same HTML const encodedUrl = encodeURIComponent(\\\"moot\\\"); const { html: postHTML } = await fetch( `https://cdn.builder.io/api/v1/qwik/${builderModel}?${new URLSearchParams({ apiKey: builderAPIpublicKey, url: encodedUrl, + \\\"query.data.slug\\\": slug, cachebust: \\\"true\\\", }).toString()}` ) .then((res) => res.json()) .catch(); --- + <html lang=\\\"en\\\"> <head> <title>{title}</title> </head> <body> <header>This is your header</header> <article> <Fragment set:html={postHTML} /> </article> <footer>This is your footer</footer> </body> + </html>\"\n    - button \"Copy to clipboard\"\n  - paragraph:\n    - text: \"Note: The variables\"\n    - code: builderModel\n    - text: and\n    - code: builderAPIpublicKey\n    - text: need to be created twice, since\n    - link \"getStaticPaths() runs in its own isolated scope\":\n      - /url: /en/reference/routing-reference/#getstaticpaths\n      - code: getStaticPaths()\n      - text: runs in its own isolated scope\n    - text: .\n  - paragraph: Now when you click on a link on your index route, you will be taken to the individual blog post page.\n  - heading \"Publishing your site\" [level=3]\n  - link \"Section titled \u201cPublishing your site\u201d\":\n    - /url: \"#publishing-your-site\"\n  - paragraph:\n    - text: To deploy your website, visit our\n    - link \"deployment guides\":\n      - /url: /en/guides/deploy/\n    - text: and follow the instructions for your preferred hosting provider.\n  - heading \"Rebuild on Builder changes\" [level=4]\n  - link \"Section titled \u201cRebuild on Builder changes\u201d\":\n    - /url: \"#rebuild-on-builder-changes\"\n  - paragraph:\n    - text: If your project is using Astro\u2019s default static mode, you will need to set up a webhook to trigger a new build when your content changes. If you are using Netlify or Vercel as your hosting provider, you can use its webhook feature to trigger a new build whenever you click\n    - strong: Publish\n    - text: in the Builder editor.\n  - heading \"Netlify\" [level=5]\n  - link \"Section titled \u201cNetlify\u201d\":\n    - /url: \"#netlify\"\n  - paragraph: Complete the following steps in order.\n  - paragraph:\n    - text: First, Go to your site dashboard, then\n    - strong: Site Settings\n    - text: and click on\n    - strong: Build & deploy\n    - text: .\n  - paragraph:\n    - text: Second, Under the\n    - strong: Continuous Deployment\n    - text: tab, find the\n    - strong: Build hooks\n    - text: section and click on\n    - strong: Add build hook\n    - text: .\n  - paragraph:\n    - text: Finally, Provide a name for your webhook and select the branch you want to trigger the build on. Click on\n    - strong: Save\n    - text: and copy the generated URL.\n  - heading \"Vercel\" [level=5]\n  - link \"Section titled \u201cVercel\u201d\":\n    - /url: \"#vercel\"\n  - paragraph: Complete the following steps in order.\n  - paragraph:\n    - text: First, Go to your project dashboard and click on\n    - strong: Settings\n    - text: .\n  - paragraph:\n    - text: Second, Under the\n    - strong: Git\n    - text: tab, find the\n    - strong: Deploy Hooks\n    - text: section.\n  - paragraph:\n    - text: Finally, Provide a name for your webhook and the branch you want to trigger the build on. Click\n    - strong: Add\n    - text: and copy the generated URL.\n  - heading \"Adding a webhook to Builder\" [level=5]\n  - link \"Section titled \u201cAdding a webhook to Builder\u201d\":\n    - /url: \"#adding-a-webhook-to-builder\"\n  - paragraph:\n    - text: \"Official resource: See\"\n    - link \"Builder\u2019s guide on adding webhooks\":\n      - /url: https://www.builder.io/c/docs/webhooks\n    - text: for more information.\n  - paragraph: Complete the following steps in order.\n  - paragraph:\n    - text: First, In your Builder dashboard, go into your\n    - strong:\n      - code: blogpost\n    - text: model. Under\n    - strong: Show More Options\n    - text: \", select\"\n    - strong: Edit Webhooks\n    - text: at the bottom.\n  - paragraph:\n    - text: Second, Add a new webhook by clicking on\n    - strong: Webhook\n    - text: . Paste the URL generated by your hosting provider into the\n    - strong: Url\n    - text: field.\n  - paragraph:\n    - text: Finally, Click on\n    - strong: Show Advanced\n    - text: under the URL field and toggle the option to select\n    - strong: Disable Payload\n    - text: . With the payload disabled, Builder sends a simpler POST request to your hosting provider, which can be helpful as your site grows. Click\n    - strong: Done\n    - text: to save this selection.\n  - paragraph:\n    - text: With this webhook in place, whenever you click the\n    - strong: Publish\n    - text: button in the Builder editor, your hosting provider rebuilds your site - and Astro fetches the newly published data for you. Nothing to do but lean back and pump out that sweet sweet content!\n  - heading \"Official resources\" [level=2]\n  - link \"Section titled \u201cOfficial resources\u201d\":\n    - /url: \"#official-resources\"\n  - list:\n    - listitem:\n      - text: Check out\n      - link \"the official Builder.io starter project\":\n        - /url: https://github.com/BuilderIO/builder/tree/main/examples/astro-solidjs\n      - text: \", which uses Astro and SolidJS.\"\n    - listitem:\n      - text: The\n      - link \"official Builder quickstart guide\":\n        - /url: https://www.builder.io/c/docs/quickstart#step-1-add-builder-as-a-dependency\n      - text: covers both the use of the REST API as well as data fetching through an integration with a JavaScript framework like Qwik, React or Vue.\n    - listitem:\n      - link \"Builder\u2019s API explorer\":\n        - /url: https://builder.io/api-explorer\n      - text: can help if you need to troubleshoot your API calls.\n  - heading \"Community resources\" [level=2]\n  - link \"Section titled \u201cCommunity resources\u201d\":\n    - /url: \"#community-resources\"\n  - list:\n    - listitem:\n      - text: Read\n      - link \"Connecting Builder.io\u2019s Visual CMS to Astro\":\n        - /url: https://www.hamatoyogi.dev/blog/astro-log/connecting-builderio-to-astro\n      - text: by Yoav Ganbar.\n  - heading \"More CMS guides\" [level=2]\n  - heading \"Featured CMS partners\" [level=3]\n  - list:\n    - listitem:\n      - heading \"CloudCannon\" [level=3]:\n        - link \"CloudCannon\":\n          - /url: /en/guides/cms/cloudcannon/\n      - paragraph: Git-based CMS built for speed, security, and zero headaches.\n  - heading \"All CMS guides\" [level=3]\n  - list:\n    - listitem:\n      - heading \"ApostropheCMS\" [level=3]:\n        - link \"ApostropheCMS\":\n          - /url: /en/guides/cms/apostrophecms/\n    - listitem:\n      - heading \"Builder.io\" [level=3]:\n        - link \"Builder.io\":\n          - /url: /en/guides/cms/builderio/\n    - listitem:\n      - heading \"ButterCMS\" [level=3]:\n        - link \"ButterCMS\":\n          - /url: /en/guides/cms/buttercms/\n    - listitem:\n      - heading \"Caisy\" [level=3]:\n        - link \"Caisy\":\n          - /url: /en/guides/cms/caisy/\n    - listitem:\n      - heading \"CloudCannon\" [level=3]:\n        - link \"CloudCannon\":\n          - /url: /en/guides/cms/cloudcannon/\n    - listitem:\n      - heading \"Contentful\" [level=3]:\n        - link \"Contentful\":\n          - /url: /en/guides/cms/contentful/\n    - listitem:\n      - heading \"Cosmic\" [level=3]:\n        - link \"Cosmic\":\n          - /url: /en/guides/cms/cosmic/\n    - listitem:\n      - heading \"Craft CMS\" [level=3]:\n        - link \"Craft CMS\":\n          - /url: /en/guides/cms/craft-cms/\n    - listitem:\n      - heading \"Craft Cross CMS\" [level=3]:\n        - link \"Craft Cross CMS\":\n          - /url: /en/guides/cms/craft-cross-cms/\n    - listitem:\n      - heading \"Crystallize\" [level=3]:\n        - link \"Crystallize\":\n          - /url: /en/guides/cms/crystallize/\n    - listitem:\n      - heading \"DatoCMS\" [level=3]:\n        - link \"DatoCMS\":\n          - /url: /en/guides/cms/datocms/\n    - listitem:\n      - heading \"Decap CMS\" [level=3]:\n        - link \"Decap CMS\":\n          - /url: /en/guides/cms/decap-cms/\n    - listitem:\n      - heading \"Directus\" [level=3]:\n        - link \"Directus\":\n          - /url: /en/guides/cms/directus/\n    - listitem:\n      - heading \"Drupal\" [level=3]:\n        - link \"Drupal\":\n          - /url: /en/guides/cms/drupal/\n    - listitem:\n      - heading \"Flotiq\" [level=3]:\n        - link \"Flotiq\":\n          - /url: /en/guides/cms/flotiq/\n    - listitem:\n      - heading \"Front Matter CMS\" [level=3]:\n        - link \"Front Matter CMS\":\n          - /url: /en/guides/cms/frontmatter-cms/\n    - listitem:\n      - heading \"Ghost\" [level=3]:\n        - link \"Ghost\":\n          - /url: /en/guides/cms/ghost/\n    - listitem:\n      - heading \"GitCMS\" [level=3]:\n        - link \"GitCMS\":\n          - /url: /en/guides/cms/gitcms/\n    - listitem:\n      - heading \"Hashnode\" [level=3]:\n        - link \"Hashnode\":\n          - /url: /en/guides/cms/hashnode/\n    - listitem:\n      - heading \"Hygraph\" [level=3]:\n        - link \"Hygraph\":\n          - /url: /en/guides/cms/hygraph/\n    - listitem:\n      - heading \"JekyllPad\" [level=3]:\n        - link \"JekyllPad\":\n          - /url: /en/guides/cms/jekyllpad/\n    - listitem:\n      - heading \"Keystatic\" [level=3]:\n        - link \"Keystatic\":\n          - /url: /en/guides/cms/keystatic/\n    - listitem:\n      - heading \"KeystoneJS\" [level=3]:\n        - link \"KeystoneJS\":\n          - /url: /en/guides/cms/keystonejs/\n    - listitem:\n      - heading \"Kontent.ai\" [level=3]:\n        - link \"Kontent.ai\":\n          - /url: /en/guides/cms/kontent-ai/\n    - listitem:\n      - heading \"microCMS\" [level=3]:\n        - link \"microCMS\":\n          - /url: /en/guides/cms/microcms/\n    - listitem:\n      - heading \"Optimizely CMS\" [level=3]:\n        - link \"Optimizely CMS\":\n          - /url: /en/guides/cms/optimizely/\n    - listitem:\n      - heading \"Pages CMS\" [level=3]:\n        - link \"Pages CMS\":\n          - /url: /en/guides/cms/pages-cms/\n    - listitem:\n      - heading \"Payload CMS\" [level=3]:\n        - link \"Payload CMS\":\n          - /url: /en/guides/cms/payload/\n    - listitem:\n      - heading \"Prepr CMS\" [level=3]:\n        - link \"Prepr CMS\":\n          - /url: /en/guides/cms/preprcms/\n    - listitem:\n      - heading \"Prismic\" [level=3]:\n        - link \"Prismic\":\n          - /url: /en/guides/cms/prismic/\n    - listitem:\n      - heading \"Sanity\" [level=3]:\n        - link \"Sanity\":\n          - /url: /en/guides/cms/sanity/\n    - listitem:\n      - heading \"Sitecore XM\" [level=3]:\n        - link \"Sitecore XM\":\n          - /url: /en/guides/cms/sitecore/\n    - listitem:\n      - heading \"Sitepins\" [level=3]:\n        - link \"Sitepins\":\n          - /url: /en/guides/cms/sitepins/\n    - listitem:\n      - heading \"Spinal\" [level=3]:\n        - link \"Spinal\":\n          - /url: /en/guides/cms/spinal/\n    - listitem:\n      - heading \"Statamic\" [level=3]:\n        - link \"Statamic\":\n          - /url: /en/guides/cms/statamic/\n    - listitem:\n      - heading \"Storyblok\" [level=3]:\n        - link \"Storyblok\":\n          - /url: /en/guides/cms/storyblok/\n    - listitem:\n      - heading \"Strapi\" [level=3]:\n        - link \"Strapi\":\n          - /url: /en/guides/cms/strapi/\n    - listitem:\n      - heading \"StudioCMS\" [level=3]:\n        - link \"StudioCMS\":\n          - /url: /en/guides/cms/studiocms/\n    - listitem:\n      - heading \"TinaCMS\" [level=3]:\n        - link \"TinaCMS\":\n          - /url: /en/guides/cms/tina-cms/\n    - listitem:\n      - heading \"Umbraco\" [level=3]:\n        - link \"Umbraco\":\n          - /url: /en/guides/cms/umbraco/\n    - listitem:\n      - heading \"Vault CMS\" [level=3]:\n        - link \"Vault CMS\":\n          - /url: /en/guides/cms/vault-cms/\n    - listitem:\n      - heading \"Wordpress\" [level=3]:\n        - link \"Wordpress\":\n          - /url: /en/guides/cms/wordpress/\n    - listitem:\n      - heading \"Zero\" [level=3]:\n        - link \"Zero\":\n          - /url: /en/guides/cms/zero/\n  - link \"Edit page\":\n    - /url: https://github.com/withastro/docs/edit/main/src/content/docs/en/guides/cms/builderio.mdx\n  - link \"Translate this page\":\n    - /url: https://contribute.docs.astro.build/guides/i18n/\n  - link \"Previous ApostropheCMS\":\n    - /url: /en/guides/cms/apostrophecms/\n  - link \"Next ButterCMS\":\n    - /url: /en/guides/cms/buttercms/\n  - link \"Contribute\":\n    - /url: /en/contribute/\n  - link \"Community\":\n    - /url: https://astro.build/chat\n    - img\n    - text: Community\n  - link \"Sponsor\":\n    - /url: https://opencollective.com/astrodotbuild"